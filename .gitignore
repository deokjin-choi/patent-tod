# 환경
**/.env

# 원자료 (용량 큼) — README만 추적
05_data/*
!05_data/README.md

# 분석 중간 산출물
04_src/**/out/
04_src/**/out_*/
04_src/**/fetched/
04_src/**/__pycache__/

# 오피스 문서
*.docx
*.doc
*.pptx
*.ppt
*.hwp
*.hwpx

# 파이썬 캐시
__pycache__/
*.pyc
*.pyo

# 선행연구 — 캐시·백업·수집 스크립트·실행 로그 (핵심은 md·bib)
03_literature/cache/
03_literature/bib_backup/
03_literature/**/*.py
03_literature/**/__pycache__/
03_literature/**/*_log.json

# Windows download metadata
*:Zone.Identifier
