@article{wang2026identifying,
  title = {{Identifying Technological Opportunities in 6G Frontier Technologies: A Science-Technology Semantic Association and Combination Graph Approach}},
  author = {Wang, Kang and Zhang, Xin and Liu, Qiwei and Han, Meng and Wang, Yue},
  journal = {Journal of Data and Information Science},
  year = {2026},
  doi = {10.1515/jdis-2025-0448},
  url = {https://doi.org/10.1515/jdis-2025-0448},
  abstract = {Purpose Identifying technological opportunities in the field of sixth-generation mobile communications (6G) is crucial for research institutions and enterprises seeking to anticipate technological trajectories, and for policymakers formulating forward-looking innovation strategies. Design/methodology/approach Grounded in the notion that scientific knowledge drives technological R\&D, this study integrates scientific publications and patent data to develop a framework for identifying technological opportunities in the 6G domain. We first employ a pretrained SBERT model to generate vector representations of mixed paper–patent data, followed by dimensionality reduction and visualization to characterize the structural features of science and technology. We then apply the HDBSCAN algorithm to identify thematic clusters across both corpora. Based on the clustering results and the semantic relationships between scientific themes and patented technologies, we construct two indicators – scientific knowledge reserve rate and technological invention competitiveness – to capture scientific and technological dynamics, respectively. A portfolio map is used to systematically identify potential technological opportunities within 6G. Findings The results demonstrate the feasibility and effectiveness of the proposed framework: eight potential technological opportunities are identified and validated to possess strong technological promise, confirming the robustness of our approach. Research limitations The analysis relies on scientific publications from WOS and patent data from DII, which may not fully capture the entire landscape of emerging 6G knowledge. Practical implications The framework provides actionable insights for 6G technology planning, enabling R\&D institutions, enterprises, and policymakers to anticipate emerging trajectories and allocate innovation resources more effectively. Originality/value This study advances technology opportunity identification by bridging scientific research and technological development through semantic analysis. It offers a novel integrative framework that uncovers deep science–technology linkages and supports the cultivation of a global 6G innovation ecosystem and next-generation intelligent communication infrastructures.},
  keywords = {02_kg_embedding; candidate: patent knowledge graph technology opportunity},
  note = {OpenAlex W7160066251; cited_by 0; abstract_source openalex}
}

@article{yuan2026trends,
  title = {{Trends and Hotspots in the Convergence of Artificial Intelligence and Cell and Gene Therapy: A Patent Analysis}},
  author = {Yuan, Hongmei and He, Yuandong and Wang, Cuiyan and Liu, Baijun},
  journal = {Current Gene Therapy},
  year = {2026},
  volume = {26},
  doi = {10.2174/0115665232515473260910071847},
  url = {https://doi.org/10.2174/0115665232515473260910071847},
  abstract = {INTRODUCTION: The convergence of Artificial Intelligence (AI) and Cell and Gene Therapy (CGT) represents a frontier in next-generation therapeutic innovation, yet the structural patterns of technology convergence within this interdisciplinary field remain poorly characterized. This study aims to develop a computational framework for predicting which technology linkages are most likely to strengthen within this convergence landscape, thereby providing a data-driven basis for R\&D resource allocation. METHOD: Global patent data in the AI-CGT field were collected to construct a time-series heterogeneous network in which International Patent Classification (IPC) codes serve as technology nodes and individual patents as knowledge nodes, capturing co-occurrence, affiliation, and citation relationships among technologies. At the macro forecasting level, a Temporal Heterogeneous Graph Neural Network (THGNN) was employed for link prediction. The model aggregated multi-hop neighbor information through meta-paths and leveraged Long Short-Term Memory (LSTM) networks to capture technological evolution dynamics, with the aim of identifying IPC pairs with the highest future association weights. At the micro-analysis level, Latent Dirichlet Allocation (LDA) topic modeling was applied to patents associated with the core IPC pairs. The optimal number of topics was determined by combining perplexity curves with inter-topic distance visualization to reveal the key technological content of these IPC associations. RESULT: The temporal heterogeneous graph neural network model achieved an Area Under the Curve (AUC) of 0.7539, Average Precision (AP) of 0.7862, and F1 score of 0.7568 for link prediction. Based on this model, multiple high-confidence convergence pathways were identified, among which the predicted potential for association strengthening between biochemical detection (C12Q1) and neural networks (G06N3) and between genetic engineering (C12N15) and neural networks (G06N3) received the highest prediction scores (0.89 and 0.80, respectively), suggesting that these pairs are likely to constitute the primary axes of technology convergence in this field. DISCUSSION: The two major convergence directions identified above correspond to the core bottlenecks in CGT clinical translation-namely, the precision and safety of gene editing, and the quality control and efficacy monitoring of therapeutic products. These findings reveal a patent-based convergence landscape in which AI-related patent classifications increasingly co-occur with both detection and therapeutic methods, indicating a trend of AI integration across the diagnostic-totherapeutic continuum at the level of patent disclosures. The identified convergence directions are computational predictions based on patent co-occurrence patterns and carry inherent uncertainty; they represent technology convergence signals rather than confirmed implementation. The "macroprediction- micro-analysis" bi-level framework proposed in this study provides a quantifiable, interpretable, and transferable analytical paradigm for technology opportunity identification in interdisciplinary pharmaceutical research. CONCLUSION: This study introduces THGNN into technology opportunity prediction in the AI-CGT convergence field and establishes a complete analytical chain from macro-level association identification to micro-level technology interpretation through LDA topic modeling. The findings offer a data-driven decision-making reference for pharmaceutical companies and research institutions seeking to strategically position their R\&D pipelines within complex technology landscapes.},
  keywords = {02_kg_embedding; candidate: patent knowledge graph technology opportunity},
  note = {OpenAlex W7215036781; cited_by 0; abstract_source openalex}
}

@article{ren2026mapping,
  title = {{Mapping China’s digital transformation: a multilayer network analysis of technology diffusion in manufacturing}},
  author = {Ren, Jialu and Zhou, Yong and Yang, Yangyang and Wang, Shengkai},
  journal = {Humanities and Social Sciences Communications},
  year = {2026},
  volume = {13},
  number = {1},
  doi = {10.1057/s41599-026-07070-w},
  url = {https://doi.org/10.1057/s41599-026-07070-w},
  abstract = {The diffusion of digital technologies has driven the transformation and upgrading of manufacturing industries. However, the main pathways and formation mechanisms of digital technology diffusion remain unclear. Using patent data of China’s manufacturing digital technologies from 2000–2024, this study constructs a multilayer network comprising patent citation networks, inter-organizational technology diffusion networks, and geographical technology diffusion networks. Through main path analysis and exponential random graph models (ERGM), we analyze the formation mechanisms of China’s digital technology diffusion pathways. The findings identify 14 main paths in patent citation networks, spanning from core technologies like image recognition to enabling applications. Inter-organizational paths center on key universities, while geographical networks exhibit a “core-periphery” structure. ERGM results reveal that technological collaboration value and combination opportunities consistently promote main path formation. However, technological diversity and proximity exhibit differentiated effects across network layers. In patent networks, neither diversity nor proximity shows significant impact, suggesting that patent citation-based diffusion prioritizes technological value and recombination potential over field diversity or similarity. In inter-organizational networks, only diversity promotes path formation, highlighting how knowledge recombination drives micro-level trajectories. Conversely, in geographical networks, both diversity and proximity inhibit path formation, indicating that macro-regional evolution requires specialized focus and complementary knowledge. Heterogeneity analysis further reveals distinct evolutionary logics: universities bridge distant domains through knowledge diversity, whereas market-driven enterprises heavily rely on high-value core technologies. Spatially, Western regions rely heavily on core technological hubs, Eastern regions are driven by knowledge recombination opportunities, and Central regions have not yet formed a dominant diffusion mechanism. This study uncovers digital diffusion dynamics and provides theoretical foundations for policymaking.},
  keywords = {02_kg_embedding; candidate: patent knowledge graph technology opportunity},
  note = {OpenAlex W7154730931; cited_by 0; abstract_source openalex}
}

@article{ren2026identifying,
  title = {{Identifying the Main Paths and Formation Mechanisms of Artificial Intelligence Technology Development in China}},
  author = {Ren, Jialu and Zhou, Yi},
  journal = {SAGE Open},
  year = {2026},
  volume = {16},
  number = {2},
  doi = {10.1177/21582440261432664},
  url = {https://doi.org/10.1177/21582440261432664},
  abstract = {The rapid advancement and widespread adoption of artificial intelligence (AI) are profoundly reshaping numerous industrial sectors. Despite this, the primary evolutionary trajectories of AI technologies and the mechanisms governing their formation have yet to be comprehensively investigated. To address this knowledge gap, our research develops a patent citation network based on Chinese patent data spanning from 1985 to 2023. Initially, distinct technological communities are identified using community detection methods. Subsequently, the Search Path Count (SPC) algorithm and the critical path method are applied to uncover the main development trajectories within each community, enabling the tracing of AI’s evolutionary history in China and the forecasting of its future course. The study further employs Exponential Random Graph Models (ERGM) to scrutinize the formation mechanisms driving these paths, which are assessed against four dimensions of technological characteristics. The findings pinpoint eight principal development paths in AI. Each path exhibits unique characteristics concerning its technical domains, foundational technologies, as well as the key contributing cities and institutions, thereby reflecting the distinct roles and orientations of different technological communities. The ERGM analysis reveals that technological proximity, collaborative potential, and opportunities for recombination significantly and positively influence path formation, whereas knowledge diversity demonstrates a negative impact. Moreover, endogenous variables related to network structure are also identified as positive drivers for the emergence of these main development paths. Collectively, these findings illuminate the current trends and future directions of AI development. They offer crucial insights for technology developers and policymakers and provide actionable guidance for traditional industries navigating the AI-driven transformation.},
  keywords = {02_kg_embedding; candidate: patent knowledge graph technology opportunity},
  note = {OpenAlex W7164809655; cited_by 0; abstract_source openalex}
}

@article{wen2021big,
  title = {{A Big Data Knowledge Computing Platform for Intelligence Studies- Wen Yi, Chinese Academy of Sciences, China}},
  author = {Wen, Yi},
  journal = {Industrial Engineering and Management},
  year = {2021},
  volume = {10},
  number = {1},
  pages = {1--1},
  url = {https://openalex.org/W3133011962},
  abstract = {Intelligence studies is a method of using modern information technology and soft science research methods to form valuable information products by collecting, selecting, evaluating and synthesizing information resources. With the advent of the era of big data, the core work of information analysis with data is facing enormous opportunities and challenges. How to make good use of big data in an effort to solve the problem of big data, optimize and improve the traditional intelligence studies methods and tools, innovation and research based on big data are the key issues that need to be studied and solved in current intelligence studies work. Through the analysis of intelligence studies methods and common tools under the background of big data, we sort out the processes and requirements of the intelligence studies work under big data environment, design and implement a universal knowledge computing platform for intelligence studies, which enables intelligence analysts to easily use all kinds of big data analysis algorithms without writing programs (http://www.zhiyun.ac.cn). Our platform is built upon the open source big data system of Hadoop and Spark. All the data are stored in the distributed file system HDFS and data management system of Hive. All of the computational resources are managed with Yarn and each of the submitted task is scheduled with the workflow scheduler system Oozie. The core of the platform consists of three modules: data management, data calculation and data visualization. The data management module is used to store and manage the relevant data of intelligence studies, which consists of four parts: metadata management, data connection, data integration and data management. The platform supports the import and management of multi-source heterogeneous data, including papers, patents from ISI, PubMed, etc., and also supports the data import with API of MySQL, Hive and other database systems. The platform has more than 20 kinds of data cleaning and updating rules, such as search and replace, regular cleaning, null filling, etc., and also supports users to customize and edit the cleaning rules. The data calculation module is used to store and manage the big data analysis algorithm and intelligence analysis process, and provides a user-friendly GUI for users to create customized intelligence analysis process, and the packaged process can be submitted to the platform for calculation and obtain the calculation results of each step. In the system, a task is formulated as a directed acyclic graph (DAG) in which the source data flows into the root nodes. Each node makes operations on the data, generates new data, and sends the generated data to its descendant nodes for conducting further operations. Finally, the results flow out from the leaf nodes. The data visualization module is used to visualize the results of intelligence analysis and calculation, including more than ten kinds of visualization charts such as line chart, histogram chart, radar chart and word cloud chart. Practice has proved that the platform can well meet the requirements of intelligence studies in various fields in the era of big data, and promote the application of data mining and knowledge discovery in the field of intelligence studies.},
  keywords = {02_kg_embedding; candidate: patent knowledge graph technology opportunity},
  note = {OpenAlex W3133011962; cited_by 0; abstract_source openalex}
}

@article{barcelos2025technological,
  title = {{TECHNOLOGICAL CONVERGENCE IDENTIFICATION MODEL (TCIM) FOR R\&D\&I ACTIVITIES}},
  author = {Barcelos, Bartholomeo Oliveira and Gonçalves, Alexandre Leopoldo and Bastos, Lia Caetano},
  journal = {Revista E-Tech Tecnologias para Competitividade Industrial},
  year = {2025},
  volume = {18},
  number = {1},
  doi = {10.18624/e-tech.v18i1.1444},
  url = {https://doi.org/10.18624/e-tech.v18i1.1444},
  abstract = {Technological advancements have accelerated the emergence of new technologies, and with these rapid changes, organizations must identify new innovation opportunities. In this context, Technology Convergence (TC) emerges as a critical factor, integrating distinct technologies to meet the complex demands of society and the competitive market. The development of research focused on identifying emerging technologies is vital to effectively respond to disruptive forces and innovate in existing businesses. To this end, the objective of this study is to propose a model aimed at identifying TC to support managers' decision-making in Research, Development, and Innovation (R\&D\&I) activities. The method employed was the implementation of the model to identify technological convergences from patent analysis, integrating Knowledge Graphs (KG), semantic technologies in Natural Language Processing (NLP), and Artificial Neural Networks (ANN) based on Transformer architectures. Preliminary results indicate that the integration of KGs, NLP, and ANNs represents a possible solution, demonstrating viability for identifying convergence patterns from patent data and assisting managers in decision-making during R\&D\&I activities.},
  keywords = {02_kg_embedding; candidate: patent knowledge graph technology opportunity},
  note = {OpenAlex W7117703214; cited_by 0; abstract_source openalex}
}

@article{noonan2012quantity,
  title = {{The Quantity and Quality of Intellectual Property Rights in China}},
  author = {Noonan, Philip},
  journal = {Australian Economic Review},
  year = {2012},
  volume = {45},
  number = {4},
  pages = {478--483},
  doi = {10.1111/j.1467-8462.2012.00710.x},
  url = {https://doi.org/10.1111/j.1467-8462.2012.00710.x},
  abstract = {You have heard already some impressive numbers about China. I would like to show you Figure 1, which contains some other big numbers about the Chinese intellectual property (IP) system. Intellectual Property Filings (Domestic and Foreign) and Economic Growth in China Note: GDP denotes gross domestic product. Source: World Intellectual Property Organization Statistics Database. The lowest line in this graph is China's gross domestic product (GDP) growth which, as you have heard, has quadrupled over the period of this graph since the mid-1990s. Above that, you can see growth in trade mark numbers, well in excess of GDP growth but not entirely out of alignment with the experience of other countries. Above that, you see the growth of industrial design applications—up more than 20 times—and the top line is numbers of patent applications, which by 2010 were more than 2,500 per cent of the value they had in 1996—not the beginning of the period of openness in China, but roughly half-way through. The word ‘patent’ is used in China in relation to three distinct types of IP rights. The first is an invention patent, which we would call a ‘standard’ patent in Australia. This is the typical inventive step instrument which leads to a 20 year period of exclusive rights. Second, we have the utility model, which is rather like an innovation patent within the Australian system—a second-tier patent. Third, there is the concept of a design patent, which is rather like our industrial design. It does not relate to inventiveness in quite the same way that the patent system does and so I will not say much more about that type of patent. Table 1 indicates the number of applications in each of these three categories which was made to the equivalent of IP Australia, the State Intellectual Property Office of China (SIPO) in 2010. You will see that there are approximately 400,000 applications in each category, totalling more than 1.2 million applications. Figure 2 shows the number of second-tier patent applications by various offices around the world in 2010. I put this chart up to illustrate the size of the application load in China. Right down on the right-hand side of the graph, we find the number of innovation patent applications lodged in Australia that year—1,465. You will see that no other country has even remotely the number of applications that China had—with Germany in second place at 17,005. China's number, 409,839, is more than 20 times larger. Utility Model Applications by Patent Office, Top 20, 2010 Source: World Intellectual Property Organization Statistics Database, October 2011. Figure 3 indicates the distribution of patent applications by fields of technology in China during the period 1996–2010. It is not dissimilar to charts that one would find for any industrialised country. There are about 10 sectors that are 4 per cent or more of the patent applications and then a large category of ‘other’, which covers all other technologies. Perhaps, one might say that the top four technologies for China are a little bit more concentrated than one might find in a fully industrialised economy, but really the picture is quite similar and the message is that China's patenting activity is as broadly based as in any other country. Patent Applications by Top Fields of Technology, 1996–2010 Source: World Intellectual Property Organization Statistics Database. One interesting characteristic of the Chinese patent system is that its impact outside China does not yet match the size of the application load within China. Figure 4 matches the number of applications made abroad by citizens of different countries. You will see that, while China has by far the largest number of patents being received in its home office, it is well down the list in terms of applications abroad, although the very rapid growth rate that you can see in this chart from 2006–2010 suggests that it will not long remain in that position. Trend in Applications Abroad: Selected Origins Source: World Intellectual Property Organization Statistics Database, October 2011. In relation to IP in China, it can be helpful to ask: ‘What does Australia want or need that it might be able to access from China?’ There are five issues that I would like to discuss here: certainty for our IP rights holders; access to ideas; collaborative opportunities; venture capital; and distribution networks in key markets. I think it would be interesting to reflect, though perhaps it is a story for another day, that China would want or need the same things (though perhaps in different proportions) from its IP dealings with Australia. When a patent application is received, an IP office must evaluate it against a number of criteria. The main ones are to consider whether the suggested new invention is: novel (in the sense that it has never been seen anywhere in the world before); inventive (in the sense that the new invention is not an obvious extension of an existing one but involves an inventive step to a new concept or principle); or useful (in the sense that the new invention has a real and practical utility such as to carry out a mechanical function or cure a disease or make a mobile phone work more effectively). The first two major tests involve a search against anything that has been published anywhere in the world. This means that, if one of the 400,000 Chinese invention patents or 400,000 utility models contains an approach that is the same as an approach that is currently before an examiner in IP Australia, the application cannot be granted. The challenges involved in ascertaining what is in the global database are enormous. Within IP Australia, we make available a complete text-searchable collection of every patent application since 1904, together with many items of metadata to assist the interrogation of the database, through our AusPat system. We also make available the entire case file online, so that you can see on the Internet a piece of correspondence relating to that matter which was sent to or from an examiner yesterday. To help our examiners to find information in other countries, we equip them with the best tools available: the principal one is the Epoque search engine, which is maintained by the European Patent Office and contains about 70 million patents from around the world and a huge volume of non-patent literature. What does SIPO offer to enable our examiners to tap in to the vast store of Chinese patent information in order to ensure that we do not inadvertently grant an application for a patent which is subsequently invalidated when prior Chinese art comes to light, which is potentially a disaster for our Australian inventors? It turns out that SIPO makes a substantial offering in English. Available through the SIPO website are English abstracts of all SIPO patents, English metadata relating to every patent and a machine translation service which enables the user to gain an approximate translation of the specification in the Chinese patent application (although, especially in a technical area like patent applications, the accuracy of machine translation is far from perfect). So, how does Australia ensure that a patent grant in Australia takes into account Chinese prior art? There are search engines which contain abstracts of Chinese patents in English. When a possibly relevant piece of prior art is found, an Australian examiner could carry out a machine translation and, if that does not conclude the matter, a colleague could be asked to help the examiner to understand the content of the Chinese application. We have three certified translators and perhaps half-a-dozen other Mandarin language-speakers within our staff of 350 patent examiners. Examiners might also examine an English-language equivalent of a Chinese patent, which might for instance have been lodged in the United States Patent and Trade Mark Office or the European Patent Office. But, none of this is perfect. Interestingly, this kind of problem is not actually new. With the industrial emergence first of Japan and more recently of Korea, accessing patent prior art in character-based languages has been a problem that the world has faced before. But, the sheer size of China's patent holding will make the question a quantitatively different one over the next decade or so. The next thing that we would want from the Chinese patent system would be to have access to the ideas that are revealed in the patent applications, all of which are published within defined time periods of their application. Not only should we be able to read a Chinese patent and build upon the inventiveness within it (such follow-on innovation being a core component of the global patent system), we should also be able to use the Chinese invention itself if the inventor has not, within a tightly prescribed time period, lodged an equivalent application for an Australian patent. In 2010, there were 242 patent applications of Chinese origin which arrived in IP Australia. While this is a figure that is growing at 20 per cent per annum, when we compare it with Chinese domestic patent filings we could say that the Chinese give us, through the patent system, 1.2 million gifts per year for us to use. Another area that can be assisted through the patent system is that of collaborative opportunities. There is a lot of work going on now at the government-to-government level to promote collaboration. This includes a Joint Science and Technology Commission between the two countries, an \$18 million Australia–China research fund and a researcher symposium to be held in Melbourne in September 2012. Already, some Australian companies do reach out to China. The number of patent applications of Australian origin being filed in China would be a proxy of this and there were 600 of these in 2010—quite a large number—although disturbingly, there has been no growth in the number over the past 4 years. IP Australia has also begun to use patent analytics private sector software within Australia. We are focused initially on helping Australian universities to identify opportunities for collaboration amongst themselves. But, there is no reason why this software could not be used by any Australian public or private sector agency to identify fields where Chinese entities are operating in the same field. One could view this as finding out who your competitors are but, more positively, it often shows an opportunity for collaboration between two bodies, each of which may have part of the solution to an important problem. It is currently challenging for Australian entities to know where to look to find Chinese collaboration partners, partly because of the size of China. Equally, our profile in China is not high in the technology area. I suspect that the average Chinese person would think of us as a source of minerals and a tourism destination primarily. People looking for high-technology solutions would think naturally in terms of North America or Europe or Japan initially. Why would they bother looking in Australia? So, the policy question is: How can we use the data in the patent system to make it easy for potential Chinese partners to find us? Venture capital is another area where Australia does not do as well as it might. There are government programs that support innovation in a whole host of ways but it is often said that the key component of converting a concept into a marketed product is an area where funding can be difficult to obtain. Well, China has plenty of money, just look at all those trade surpluses. The question here is: How can we ensure that Chinese venture capital funds look at us when considering where to invest? Again, we may not be the logical first thought and we need to organise ourselves to meet this challenge. There have been some steps taken by institutions to advance this area. Australia's Knowledge Gateway, produced by the Group of Eight Australian universities, is a web-based offering which seeks to bring together experts and their publications, although it is not specifically focused on technology matters. The University of New South Wales has recently launched its Easy Access IP system, offering free access to the university's IP based on generous conditions, perhaps the most important one being that you must use the IP. The University of Adelaide, through its Adelaide Research and Innovation Centre, has put a lot of effort into presenting its projects in a more user-friendly way so that busy people can find the person within the university who may be working on a question that they are especially interested in. Despite these useful initiatives, there is more that we could do in this area if we want to maximise our attraction for investment capital from China. The final area that I would mention is distribution networks in key markets. China itself is a big and very challenging market for Australian companies. Because of its small size, Australia has always needed to put special thought into accessing networks of this nature. Here are two examples that do not immediately involve China. Bionomics is a South Australian firm with very promising biotechnology inventions and has recently entered into a multi-hundred-million-dollar distribution deal with a North American provider. The funding is partly of course about manufacturing, but it is at least as much about distributing the product from a smallish company in Adelaide to the whole of the North American market in a way that will maximise market share. Similarly, Gardasil, whose inventors were never that intent on maximising profits, would only have been able to have the enormous impact that it is now regarded as likely to have because a partnership was negotiated with a multi-national pharmaceutical company to enable the distribution of the product through that company's resources. So, the question here is: How do we build distribution networks within the Chinese market so that Australian IP can maximise its commercial value within China? I conclude by once again considering the five IP components that Australia wants and needs in its dealings with China. The first two confront the language barrier if we are to secure a position as well as we might and the last three—collaborative opportunities, venture capital and distribution networks in a key market like China—all require us to present and explain ourselves as persuasively as possible to this large Chinese market.},
  keywords = {02_kg_embedding; candidate: patent knowledge graph technology opportunity},
  note = {OpenAlex W2119253505; cited_by 0; abstract_source openalex}
}

@article{20212018,
  title = {{تحلیلی بر مفهوم توسعۀ شهری دانش بنیان با تأکید بر عامل شکاف دیجیتال در کلانشهرهای ایران (مورد: تبریز 2018)}},
  author = {روستایی, شهریور and رنجبرنیا, بهزاد and پورمحمدی, محمدرضا},
  journal = {DOAJ (DOAJ: Directory of Open Access Journals)},
  year = {2021},
  volume = {25},
  number = {75},
  pages = {157--170},
  doi = {10.22034/gp.2021.10824},
  url = {https://doi.org/10.22034/gp.2021.10824},
  abstract = {Introduction Since the 1990s, after both economy and society moved from Fordism to post-Fordism, a new paradigm emerged from the beginning of the new century. Due to the impact of the knowledge economy on urban communities, this paradigm known as knowledge-based urban development emerged in the late 20th century (Yigitcanlar et al., 2008a: 64). The knowledge-based urban development concept was considered as a practical management strategy for urban residents in various areas of sustainable social, economic, and urban growth along with the postmodern development of urban areas. Meanwhile, despite the benefits of superior information and communication technologies in urban areas and in particular the topics related to these technologies in accelerating the process of knowledge-based urban development, this factor can cause major challenges in balanced urban development. In this regard, one of the main obstacles in this area is the digital divide. The digital divide refers to the inequality in access of all members of society in terms of quantity and quality to information and communication technologies. In most societies, the right to create information is practically given to everyone, but distribution or sharing is taken away from them; hence, information resources are not used equally by society (Lievrouw and Farb, 2003: 414). Some societies deal with a deep digital divide in terms of information technology, which in turn impedes the realization of the city of knowledge. In various sources, the digital divide is mentioned as one of the barriers to a knowledge-based city (Butcher, 2009: 59 \& Norris, 2001). Considering the above-mentioned cases, Tabriz metropolis needs to reach a variety of goals to become a knowledge-based city. One of these goals is identifying the impact of the digital divide on the concept of knowledge-based urban development. Therefore, the focus of this article is on the study of the effect of digital divide indicators on knowledge-based urban development variables in the city of Tabriz. Data and Methods In the present article, the structural equation model has been utilized to comprehensively study the conceptual model of the research. In this study, the opinions of 50 experts have been taken. To estimate the impact of digital development factors and gaps on each other, researchers created a 44X44 matrix by considering 32 knowledge-based urban development sub-indices in addition to the 12 digital gap variables within a system. Accordingly, after obtaining the outputs related to the expert’s opinions, these results were analyzed in MicMac software. Software outputs can greatly help to understand the dimensions and relationships of the system along with the way the system will work in the future in the various forms of tables and graphs (Rabbani, 2012). Results and Discussion According to the analytical results of this matrix, the variables including government influence, strategic planning, managerial interventions, broadband access, and social stability have the highest effect on the system. Furthermore, the most susceptible direct variables of the system include geographical location, urban competitiveness, foreign direct investment, economic status, research, and development. By observing the obtained results, it is easy to see the government’s role in positive or negative effectiveness in reaching the goals of digital city and knowledge-based urban development. Additionally, the results obtained from the distribution chart of variables have the following points: Determinants and influential variables (Located in the northwest of the Chart with High effectiveness and Low susceptibility): Management interventions, age, broadband access, cost of living, affordable housing, networking and strategic cooperation, justice, and social integration. Two-fold variables (located in the northeast chart - high effectiveness and low susceptibility): urban competitiveness, quality of life, government impact, e-government, strategic planning, urban branding, etc. Result variables (located in the southwest of the system- low effectiveness and high susceptibility): patent applications, worker knowledge pool, educational investment, basic professional skills, language skills, and socio-economic dependence. Independent variables (located in the southeast of the system - low effectiveness and susceptibility): cultural and social norms, disability and physical ability, social stability, unemployment, environmental impact, use of sustainable transportation, etc. Conclusion To achieve structural knowledge-based urban development, the influential factors within this type of development are considered as an interwind or structure (system) to measure their inter-relationships due to enabling users to extract key variables of the system. In the present study, a variety of indicators were assessed for tackling problems related to the digital divide within the city and altering it to digital equity in Tabriz city. Those variables with the maximum effectiveness along with two-fold indicators have been chosen as key factors. A brief look at the concepts used in this study indicates that there is a conflict between the concept of the digital divide and urban knowledge-based development. In this regard, to eliminate this conflict, it is necessary to increase the efficiency of some variables. These variables include improving existing management tools and policies, strengthening the existing infrastructure for easy access to ICT by citizens, increasing people's skills and awareness, and finally strengthening the people's economic status by turning the digital divide into an opportunity along with providing a basis for the successful realization of knowledge-based urban development.},
  keywords = {02_kg_embedding; candidate: patent knowledge graph technology opportunity},
  note = {OpenAlex W3042918530; cited_by 0; abstract_source openalex}
}

@article{donelan2021preview,
  title = {{Preview the Products on Display at Display Week 2021}},
  author = {Donelan, Jenny},
  journal = {Information Display},
  year = {2021},
  volume = {37},
  number = {3},
  pages = {53--66},
  doi = {10.1002/msid.1220},
  url = {https://doi.org/10.1002/msid.1220},
  abstract = {DISPLAY WEEK'S 2021 VIRTUAL EXHIBITION HAS BEGUN! As always, you'll discover new technologies, devices, capabilities, and partners on the exhibit hall floor. This year's virtual format will allow you to engage with exhibitors in ways both familiar and new, with one-on-one video chats, product demos, and more. We asked companies to highlight the most exciting new products they plan to show at Display Week. Dozens of participating exhibitors responded with a taste of what you can expect to see from May 17–21, 2021. For additional details, visit displayweek.org. https://abrisatechnologies.com Ready-To-Install Enhanced Glass Abrisa Technologies provides ready-to-install enhanced glass solutions for the display, scanner, and sensor markets. Made from custom or cut-to-order antireflection-coated, non-glare glass, ultrathin glass, or damage-resistant high ion-exchange aluminosilicate to exact specifications, the glass can incorporate value-added screen-printed graphics (frit or epoxy/polyester) as well as oleophobic or optical coatings (UV or IR solar blocking, EMI or heater ITO/IMITO, optical filtering, and bus bars), applied films, and gaskets for a total solution. Abrisa's large inventory of specialty and technical glass accommodates both low- and high-volume requirements with a wide array of process options, including complex CNC configurations from micro to meter sizes. admetro.com Intelligent PCAP Controller A D Metro's new ARGON PCAP controller is a significant advancement in PCAP technology. It detects and automatically adapts to a wide range of off-the-shelf sensor sizes, formats, and cover glasses. A built-in configuration capability offers adjustment of orientation, touch-sensitivity maximum concurrent touches, and many other settings. This is particularly useful for embedded applications. This controller does not need any tuning software to set its parameters, making it easy to set up anywhere, anytime. It also does not require dedicated hardware drivers, making it compatible with any operating system that works with a mouse. It simplifies inventory for customers wishing to implement PCAP in their product offering but wanting only one controller configuration that can handle all their sensor size requirements. www.agc-plasma.com Antireflective Coating Equipment AGC's antireflective (AR) coating equipment platform enables seamless and efficient mass production of even the most complex optical coating products. A leading glass-industry producer and innovator combines world-class optical design know-how with in-house engineering to offer the most advanced coating platform to date for high-volume industrial production. Glass or polymer substrates up to 3 meters wide can be processed with an in-line or a roll-to-roll equipment form factor. AGC AR coaters integrate state-of-the-art innovations such as PlasmaMAX PECVD coating sources and iOSMB technology to enable high-rate coating of both flat and 3D substrates with precise uniformity control. www.aft-website.com/en Functional Adhesive Encapsulation Film Ajinomoto Fine-Techno provides the insulation film Ajinomoto Build-up Film to the semiconductor industry. The company also offers the low-temperature, curable, one-component thermosetting adhesive “PLENSET” for heat-sensitive device assembly, such as for complementary metal-oxide-semiconductor (CMOS) camera modules. Based on these technologies, Ajinomoto developed a functional adhesive film called AFTINNOVA Encapsulation Film (AEF) for display devices. The barrier-type AEF series has been newly designed to bring high reliability to moisture-sensitive devices, such as OLEDs, by preventing moisture permeation. The company's products enable customers to achieve next-generation displays, such as foldable OLEDs and mini- and microLEDs. www.applasma.com Atmospheric Plasma System APP specializes in atmospheric plasma technology such as argon, air (Penjet) and N2 (Penjet wide) plasma solutions, and in customized Ar plasma solutions for both OLED TVs and mobile-size products for processes such as polyimide etching, cleaning, anisotropic conductive film bonding, and more. www.benteler-glass.com Thin-Glass Washing Machine The BENTELER Thin-Glass Washing Machine is marked by enormous diversity. Its areas of application are found in cleanrooms or other places demanding complex washing tasks. The BENTELER thin-glass washing machine is made of high-grade materials in the washing zone. Its modular design allows flexibility for various application cases. The washing machine therefore can be configured according to customers’ wishes. Advantages include highest washing and drying quality; installation in an in-house cleanroom; spray zones with up to 140 bars; double housing, which prevents the introduction of machine-induced particles; and ultrasonic cleaning with up to 950 kHz. www.astrodesign.co.jp/english Display MTF Measurement System ASTRODESIGN has developed the Display MTF Measurement System (DT-8031/DT-8031-MV) with the cooperation of NHK. DT-8031/DT-8031-MV is an application that can be used with a signal generator and an imaging light-measuring device (LMD) to measure the spatial imaging performance of a flat-panel display in real time. This newly developed system measures modulation transfer function by analyzing an image of a displayed single line captured by a VGA industrial camera operating as the LMD. The system can also measure contrast modulation using grille patterns. Using DT-8031/DT-8031-MV, users can investigate how factors such as subpixel layout, rendering, and diffusers affect display resolution. www.benqmaterials.com OLED Color-Shift Film As various foldable devices come to market, solving color-shift problems for large screens becomes all-important. BenQ Materials’ color-shift film has microstructures integrated with the front cover to modify light distribution and reduce color shift. Applying an OLED color-shift film to the front cover of an active-matrix OLED (AMOLED) not only makes it foldable and rollable, but also improves OLED color shift by modifying red, green, and blue (RGB) light distribution. With ever-expanding RGB OLED sizes, viewing-angle picture quality becomes all the more important and makes OLED color-shift films indispensable. BenQ's OLED color-shift film is based on its proprietary technology, including patented formulas, coatings, and microstructures. www.boe.com 8-Inch FHD Sliding Rollable AMOLED The 8-inch FHD sliding rollable AMOLED from BOE uses flexible multilayer on a cell technology and an independent module support structure that can solve the crease problem effectively to improve touch support and dynamic performance. The curved pad-bending technology and 3D edge-fitting technology also are used to realize narrow-border and curved-edge displays. More than 200,000 instances of R4 outer bending dynamic roll sliding have been carried out. Different from the folding form, the sliding roll form product is lighter, thinner, and stronger, giving users an uninterrupted experience in the process of switching between a mobile or pad terminal. cerionnano.com Custom Nanomaterials As a global leader in designing, scaling, and manufacturing custom nanomaterials for next-generation products, Cerion provides the expertise and materials customers require so their teams can stay focused on advancing the development and delivery of their products and systems. Cerion's specialty is designing solutions that are compatible with a company's products and processes, allowing the customer to seamlessly integrate the nanomaterial and preserve its performance. Cerion's process includes working to understand the customer product requirements, manufacturing conditions, and desired end-state of the nanoparticle for integration. For incorporation into display products, this often requires nanomaterial optimization, including particle size and distribution, surface charge, surface functionalization, and solvent system. www.corning.com Slim Display Glass EAGLE XG Slim Glass substrates enable panel manufacturers to innovate for thinner and lighter display panels. EAGLE XG Slim Glass delivers dimensional stability and exceptionally clean, smooth, flat surfaces—qualities essential to the successful manufacturing of LCDs. The glass composition includes no added heavy metals and features exceptional thinness, helping panel makers reduce or completely avoid the potential environmental and health hazards associated with panel thinning. EAGLE XG Slim Glass is available in 0.25 mm up to Generation (Gen) 5.5, 0.3 mm up to Gen 6, 0.4 mm up to Gen 8.5, and 0.5 mm up to Gen 10.5. www.dexerials.jp/en Antireflection Film HD Series As the integration of touch functionalities to displays increases, the durability of the anti-smudge layer becomes more important. Therefore, Dexerials has developed a new AR film high-definition (HD) series with a high-performance anti-smudge layer applied by physical vapor deposition (PVD) instead of by conventional “wet”-type processes. The new product retains the excellent optical properties of existing AR film products and achieves the high durability and superior abrasion resistance of the anti-smudge layer. www.dlcdisplay.com 2.45-Inch IPS Display DLC Display is pleased to introduce its 2.45-inch in-plane switching (IPS) display with 272 × RGB × 480 resolution. DLC features twisted nematic/super-twisted nematic, thin-film transistor (TFT), and OLED displays, including all ancillary components related to displays. The company also provides many special products, such as transflective TFT, high-brightness TFT, wide-temperature TFT, and long-lifetime TFT. It has been an industry leader in the design and manufacturing of display products, and its business has become global in recent years. http://dnpamerica.com Conductive Film with Ultrafine Mesh DNP film has a nearly invisible ultrafine mesh wiring on its surface, which is applied to the display surface of smartphones and other devices without losing clarity. The mesh wiring functions on the surface of the display as an antenna and does not require additional space to store an antenna, which can lead to thinner devices. This mesh wiring film could be used as a surface antenna for many kinds of 5G communication devices without impacting the device's design. The mesh wiring film can be used in building construction by applying the film to walls, ceilings, and windows. www.dow.com/en-us/market/mkt-electronics/sub-elec-consumer-computer-comm.html Materials for the Display Supply Chain Dow delivers a complete portfolio of high-performance materials such as DOWSIL for assembly, bonding, sealing, potting, thermal management, electromagnetic compatibility, and many other challenging uses across the industry's supply chain. From factory tablets to smartwatches to connected kitchen appliances, Dow is helping to optimize the reliability, protection, safety, and aesthetics of next-generation communications and consumer electronics. www.eink.com Color Filter Array The latest E Ink Kaleido Plus display has a new printed color filter array (CFA) technology in conjunction with E Ink's latest generation, faster, and brighter ink layer. Kaleido Plus provides 16 levels of grayscale, 4,096 colors, and an ultralow power, paper-like experience. In addition, the printing pattern is improved and is closer to the ink layer to create brighter colors with better text rendering. Kaleido Plus is ideal for image-rich information applications, such as charts, graphs, maps, photos, comics, and advertising. As with E Ink's monochrome e-Paper products, Kaleido is fully viewable in direct sunlight. www.eldim.fr Viewing-Angle Measurement ELDIM's viewing-angle series products have been developed to bring a major competitive advantage in measuring and analyzing viewing angle for all kinds of displays. The CubeX system is the latest product in the company's viewing-angle range. It ideally is suited for production-line color standardization of screens, with its easy implementation and maximum action time demand (takt time) speed of less than 2 seconds per screen. Using an on-axis spectral sensor and new angular spectral mapping technology, CubeX provides precise color information in a field of view of +/–60°. www.emd4displays.com OLED Materials OLED creates a world of opportunities for displays with its thin, free-form, and transparent qualities. Scientists at Merck have been at the forefront of OLED innovation. Its hole transport materials, for example, are an essential enabler for OLED TV and mobile displays, delivering breakthrough efficiency as well as a longer lifetime by steering charge flow across the OLED stack and ensuring easy processability during production. OLED materials are another example of how EMD Electronics is transforming electronics atom by atom. smartembeddeddisplay.com Smart Embedded HMI Emerging Display Technology's (EDT's) Smart Embedded products are highly human-machine-integrated (HMI) solutions architected to simplify and accelerate the graphical user interface (GUI) implementation for customers’ products. EDT's Smart Embedded Development Kits enable engineers to quickly develop proof-of-concept HMI prototypes, and its off-the-shelf standard products allow customers faster time-to-market. Smart Embedded products include an embedded controller board integrated with a TFT display and touch panel as one compact module in sizes from 4.3∼10.1 inches. They include all necessary electronics to control the TFT display module, backlight, PCAP touch panel, and GUI application. Other sizes, resolutions, and full- and semi-custom modules can be built to customers’ requirements. www.europtecusa.com Etched Antiglare Glass Albatross Glass is a new etched antiglare glass product designed to minimize sparkle on high-pixel-density displays. The product builds on 40 years of etching experience producing EagleEtch glass and completes the company's offering of high-performance antiglare glass products for all applications. Produced in the United States, EuropTec USA products are available with short lead times and are relied upon around the world for critical applications, from fighter jets to medical displays and consumer automotive. www.flexigo.co.kr Flexible Display Durability Tester Key features of FlexiGO's Flexible Display Durability Tester include stress-free folding (while folding along the rotation path, no external force is applied to the sample); tension-controlled rolling (the torque motor enables a rolling test with constant force, and real-time tensile force is measured using load cell); stress-free sliding (also performed without applying any stress to the sample); optimized chamber design, with no condensation because of a dual heating-wired glass door and servo motor outside chamber; and automatic and versatile inspections. www.goworld-lcd.us Curved and Flexible Touch Sensors Goworld is a leading manufacturer of capacitive touch panels for the automotive industry. In addition to its anti-glare, anti-reflective, and anti-fingerprint coatings for touch-panel surfaces, it has developed curved and flexible touch sensors. Goworld uses molding and patented high-transmissive, high-reliability polyimide material to produce curved and flexible touch sensors that were beyond imagination until recently. The new technology has been designed into several vehicles. www.gamma-sci.com/products/ned-lmd-wg-series NED-LMD Waveguide Tester The NED-LMD Waveguide Tester is the first automated near-to-eye display measurement system that mimics human visual perception for fast, accurate, and repeatable characterization of next-generation optical waveguide-based AR/MR headsets. A “robotic eye” helps device manufacturers predict how the human eye would perceive their AR/MR displays, quantifying the end-user experience in mapping the entire display field of view. It features the highest imaging resolution of any existing XR test instrument; the largest device field-of-view coverage; a fully automated, standardized software test suite measuring see-through waveguide image quality and coloration defects; and true color measurements using a spectroradiometer. www.incomusa.com Infinity Fiber-Optic Tiles Incom's Infinity Tiles use a revolutionary manufacturing process to produce a low-magnification/low-profile polymer-fused fiber optic. It allows for an image to expand a small distance to bridge the area of a bezel around a display with controlled distortion and consistent transmission. These tiles are manufactured to custom requirements, and provide a way to array multiple displays, creating a seamless imaging plane. Because of their low-cost and low-weight polymer fiber optic materials, this novel Incom technology allows commercial applications to tile large displays without seams and makes possible a display without bezels. www.instrumentsystems.com Optical Testing for AR/VR To ensure a perfect user experience, extensive and highly accurate optical tests are necessary not only for the virtual display, but also for all other light sources and sensors of an AR/VR headset. Instrument Systems has optimized its well-known LumiTop 2D imaging colorimeter for production testing of AR/VR near-to-eye displays. Simultaneous measurement of a 2D image, spectrum, and flicker makes LumiTop a fast, comprehensive, and highly accurate imaging light-measurement device. For testing IR sources (near infrared [NIR] LED, vertical cavity surface-emitting laser [VCSEL]) often used for gesture and object recognition, the company offers exceptional solutions as pulsed VCSEL testers and videoconferencing (VTC) far-field analysis cameras. https://inziv.com MicroLED Testing System The OmniPix-ML1000. the first all-encompassing automated microLED testing system, offers both full wafer and localized individual pixel inspection. The system uses automated optical inspection, photoluminescence, and electroluminescence to provide the most critical measurements for today's microLED testing needs, including external quantum efficiency and angular measurements. With the highest resolution measurements, the OmniPix-ML1000 provides a state-of-the-art solution for automated microLED inspection and characterization. The OmniPix-ML1000 integrates multiple inspection modalities in one system and provides a comprehensive analysis of both the whole wafer and its subpixel features. The unique combination empowers microLED developers with the ability to address today's most critical challenges in microLEDs. www.j-display.com/english/ Transparent Display This newly developed transparent display with a “clear allows to see on both of the applications were these including in which a transparent with a transparent display enables to information from to see the This can be in is real-time which will allow the in front of the display to the during This can be for with or for in a MicroLED Display series of active-matrix microLED displays is the latest addition to its of microLED displays. The microLED displays in this series have a display area of in and a resolution of × making the and VGA display panels the size of a of one of these display panels can be designed into glass because of its The display is of for a of Measurement has and for its performance. It measurement for and OLED manufacturers and is a global leader for measurement and has also developed a system for color as well as inspection It is the only in the will its to provide the most complete measurement and analysis solutions for the industry. Display Color for AR/VR and the display Display Color with mm and mm small the of and in the of micro and small displays. the company at the at Display for its on AR/VR and camera applications for measuring and display also will its series and its use with measurements for AR/VR applications. combines and to provide a with times efficiency than without using any as an generator and to by devices of wide color space and are