@article{wang2024from,
  title = {{From technology opportunities to solutions generation via patent analysis: Application of machine learning-based link prediction}},
  author = {Wang, Ziliang and Guo, Wei and Shao, Hongyu and Wang, Lei and Chang, Zhixing and Zhang, Yuanrong and Liu, Zhenghong},
  journal = {Advanced Engineering Informatics},
  year = {2024},
  volume = {62},
  pages = {102944--102944},
  doi = {10.1016/j.aei.2024.102944},
  url = {https://doi.org/10.1016/j.aei.2024.102944},
  abstract = {Technology convergence represents a significant mode of technological innovation that is widely prevalent across various industries. This innovative approach integrates multiple technologies to develop new integrated solutions, thereby fostering a competitive advantage for enterprises . Anticipating future potential technology convergence is of paramount importance for businesses. However, previous research has predominantly relied on the topological information of convergence networks, overlooking the nodal attributes and inter-nodal relationships that have an impact on the emergence of technology convergence. To enhance existing studies, this paper employs three types of features: node attributes and inter-node relationships based on the drivers of technology convergence, along with link prediction similarity indices . Additionally, we utilize Graph Convolutional Neural Network (GCN) for node embedding to leverage node attributes. Machine learning models are utilized for link prediction based on these features to identify potential technology opportunities. To guide research and development (R\&D) efforts, we recommend high-value patents for each node using entropy weighting across five metrics that objectively quantify patent value, and transform patent abstracts into vectors using Doc2Vec. Patents with high similarity in abstract text between nodes are utilized to extract technical solutions and fuse ideas for technology convergence. A case study is conducted within the autonomous driving industry, leveraging comprehensive information including node attributes, inter-node relationships, and topology-based similarities to identify technology opportunities and guide the generation of R\&D ideas through the convergence of technical solutions.},
  keywords = {02_kg_embedding; candidate: link prediction technology convergence patent},
  note = {OpenAlex W4404328593; cited_by 30; abstract_source openalex}
}

