@article{kang2022prediction,
  title = {{"Prediction of Defense Science and Technology Convergence using Graph Neural Networks"}},
  author = {Kang, Ji-Cheol and Kim, Kyung‐Soo and Cho, Nam-Wook},
  journal = {대한설비관리학회지},
  year = {2022},
  volume = {27},
  number = {3},
  pages = {21--31},
  doi = {10.35373/kmes.27.3.2},
  url = {https://doi.org/10.35373/kmes.27.3.2},
  abstract = {Purpose This paper aims to predict the technology convergence in the defense field using link prediction models, including topological feature-based models and a graph neural network model. Methods Based on the patent data from 1979 to 2020, link prediction models for convergence technology have been presented. Topological feature-based models and a graph neural network model are implemented. Results A graph neural network model showed better performance than topological feature-based models, so future conversion networks are predicted based on the graph neural network model. As a result of the link prediction, battery technology will play an important role in connection with other military technologies in terms of technology convergence. Conclusion The main contribution of this paper is to show the future direction of defense R\&D promotion from the viewpoint of technology convergence. As a defense technology strategically promoted by the government, investment is necessary to develop it into a mature technology. Therefore, the results can be used as a guideline when the government prioritizes investment strategies in the defense sector.},
  keywords = {02_kg_embedding; candidate: link prediction technology convergence patent},
  note = {OpenAlex W4304172423; cited_by 1; abstract_source openalex}
}

@article{friedberg2008time,
  title = {{Time for a Reality Check: The Hospital-Based Laboratory's Perspective}},
  author = {Friedberg, Richard C.},
  journal = {Archives of Pathology \& Laboratory Medicine},
  year = {2008},
  volume = {132},
  number = {5},
  pages = {781--784},
  doi = {10.5858/2008-132-781-tfarct},
  url = {https://doi.org/10.5858/2008-132-781-tfarct},
  abstract = {To place a cloak of reality on business prognostications, the first questions to answer are (1) what is the real business in consideration, (2) what are the components or analogs to that business that may be affected differently by the predictions, (3) what are the key drivers that help direct change in that business, and (4) what are the key impediments to change?The business in consideration is not simply performing laboratory testing but rather the delivery of diagnostic medical information to health care providers. Hospital-based outreach laboratories are in the business because they can generate revenue from underutilized capacity. The hospital requires a laboratory, already has significant sunk costs in the form of equipment and staffing, and must maintain excess capacity especially at night. Therefore, additional specimens from novel sources can generate revenue at the margin. Political reasons to provide the service may also exist, but essentially, hospital-based laboratories got into the business because they had capacity, there was a need, there was a market, and there was potential revenue flow. They stay in the business because they are accustomed to the cash flow and the local political goodwill is often strong.The components or analogs are academic, hospital, and commercial laboratory testing. There are plenty of advantages and disadvantages to each business model. The biggest differences are the key drivers that motivate the business. Academic facilities are ostensibly driven by scholarly output, scientific research, and education, often measured by peer-reviewed publications and grant-generating activity, but the real underlying measure is direct and indirect cost recovery. Hospital-based laboratories are providing a service for the key revenue-generating services (eg, surgery, cardiology), and any added revenue is perceived as gravy. For commercial laboratories, the key drivers are economic. Industry requires a profit margin to appease the shareholder base and consequently must deliver services. Generally, industry prefers exponential growth, which is inherently difficult to maintain. Commercial operations may have a scientific mission, but typically it is subordinated to economic considerations and considered successful only if the net return on investment is positive.For all these laboratories, however, the key impediment to change is inertia. The academic world generally believes that industry can be more nimble, but that is not true. Big industries are very slow to move. Where they outperform academia is in planning.Hospitals have laboratories … some have an Outreach Program … some know what they are doing … some have a parent that helps … some will take advantage of technology … some will still be around in a few yearsEssentially all hospitals have a laboratory. Some of them have an outreach program, some know what they are doing, some have a parent that helps, some will take advantage of technology, and only some of those will be around in a few years. Each level is a subset of the preceding level. Not too many years ago, all radiology and pathology was hospital-based. Then came the technology-induced shakeout in radiology. Those who knew what they were doing and took advantage of technology had a far greater chance of survival than the others. Today, medicine sees all radiologists in a very comfortable fit with their technology. Clearly missing are those who just wanted to read the traditional films, as they departed the scene years ago. Those radiologists are like most dinosaurs that died out because they could not adapt rapidly enough; others, however, are like the chickens and birds that survived. The ones that died out may have been perfectly good dinosaurs, but that did not help much. Are some or all pathologists bound to be dinosaurs?Where will hospital-based laboratories be in the future? As the Danish physicist Niels Bohr (1885–1962) noted “Prediction is very difficult, especially about the future.” The tendency is to look at the future and predict the future as a linear extrapolation of today, sort of a “today on steroids.” One- to 3-year predictions generally overstate the impact of change, whereas the 5- to 10-year predictions are understated. The 1939 World's Fair in New York envisioned an end-of-the-century United States crisscrossed with pneumatic tubes to allow direct transcontinental message delivery. The 1960s Star Trek television series did not have a single personal computer or PDA on the Enterprise but highlighted a voice-activated mainframe computer. Their 24th century handheld communicator is already outdated by the common cell phone today. Longer term predictions tend to be far off base, yet short-term predictions are often overstated. Both miss disruptive technologies.Long-term pressures need to be considered in any assessment of economic predictions and implications. In the laboratory world, those pressures include (1) increases in knowledge drive down the cost per unit; (2) competition based only on price leads to commoditization and often results in a race to the bottom of quality; (3) market dynamics eventually do prevail, as protectionist tactics may work in the short term, but are temporary at best; and (4) corporate size is not always an asset.In days gone by, pathology provided the vast majority of knowledge necessary to make the diagnosis. Today, however, that necessary clinical information transcends traditional pathology and now includes immunohistochemistry, genotypes, multivariate index assays, and imaging. The pieces of the final diagnosis that are derived from traditional pathology comprise a shrinking piece with diminishing returns to match. One of the big threats today for anatomic pathology is in-sourcing, which is increasing as a novel revenue option for medical groups that generate a significant volume of office-based biopsies. Across the nation, gastrointestinal, urology, and dermatology practices are adding histology facilities to keep the volume in house. Centers for Medicare \& Medicaid Services reimbursement practices actively encourage the trend. Between 1999 and 2007, the technical component of the primary anatomic pathology Current Procedural Terminology (CPT) code (CPT 88305 surgical pathology, gross and microscopic examination, level IV) from Medicare increased from \$19.80 to \$64.95, whereas the professional component diminished from \$45.15 down to \$38.05 (unadjusted for geographic practice cost differences). This corresponds to a compound annual growth rate of 16.0\% for the technical component versus −2.9\% for the professional component. When a biopsy-generating practice sees the role of the pathologist as a commodity, its strongest incentive is to improve its own economics at the expense of a commodity broker.As more information becomes necessary to make the complete diagnosis and a lower proportion is provided by traditional pathology, market forces are dictating diminished revenue for the shrinking piece. This shift markedly loosens the grip of a traditional hospital-bound laboratory on the providers, especially if they cannot provide the level of customer service equivalent to that of the large reference laboratories. Many laboratories and pathologists have tried to hide behind the Clinical Laboratories Improvement Act of 1988 (CLIA '88), regulatory controls, and the corporate practice of medicine. In time, CLIA '88 will change and patent laws will evolve. Large corporations may seem to have an edge, but they lumber under the weight of internal communication and coordination. Laboratories, regardless of size, that can adapt to an evolving medical and technologic climate will have the greatest chance of survival.Predictions on personnel can be summarized as “no good news on the supply of technologists.” There will be the same number or fewer; we will simply need to better utilize the ones we have. We can expect to have significant staffing challenges as we implement advanced technology and information systems. We need well-educated personnel with expertise in science, engineering, informatics, and medicine and will be competing with those industries for talent. The gap between qualified supply and demand will continue to widen, and the age demographics are not in our favor. That 1970s graduate who sought a career in medical technology has many more available options today, most of which are more lucrative, flexible, and lifestyle-friendly.On the physician front, there will be a tight market for well-trained, subspecialty-focused, “digitally intact,” “clinically intact” pathologists. By digitally intact, I mean pathologists who are comfortable with computers and electronic means of information acquisition and delivery. By clinically intact, I mean pathologists who are comfortable both on the patient floor and in other aspects of the direct patient care arena. We need pathologists who are going to communicate with the attending provider and see themselves as clinical physicians and not just basement-bound technicians or scientists. There will likely always be a surplus of generic, “nonintact” pathologists.Technological advances will derive from not only the expected areas of molecular diagnostics and extensions of well-known techniques such as immunoassay but also relatively unfamiliar arenas such as genomics, proteomics, multivariate index arrays, and multimodal aggregated panels of biomarkers. Tools from radiology and nuclear medicine will cross into the traditional domain of the laboratory. There is a distinction between the convergence of technology and convergence of individuals. I do not expect to be a radiologist; I expect to use some of their tools. Increasingly, combinations and derivatives of computed tomography (CT), magnetic resonance imaging (MRI), and positron emission tomography (PET) are being used to define “molecular imaging” as a distinct tool in the diagnostic armamentarium. However, there is no clear understanding of what constitutes a “diagnostic image” outside of the traditional diagnostic techniques of pathology, such as hematoxylin-eosin (H\&E) staining of formalin-fixed, paraffin-embedded (FFPE) tissue, which remains the gold standard. Nevertheless, advances in imaging technology will alter the traditional activities occurring in the diagnostic laboratory.Given the widespread adoption of teleradiology in the past 5 to 10 years, why has pathology not followed suit? There are key differences in telepathology and teleradiology. Teleradiology took off because the image is acquired digitally with full detail at a manageable file size. Pathology images today are neither. The digital radiology image is the diagnostic image, with all the information on the display screen. Telepathology is teleconsultation; teleradiology is telediagnosis.Information systems technology is on the verge of delivering a true electronic medical or health record. There are plenty of electronic record systems available, but few are integrated enough to be truly considered as a complete medical record. Most are simply overlays on information silos. Just as powerful searching technologies changed the way we use the Internet, innovations in data mining will change the manner we aggregate disparate information to provide better-informed decision making and treatment plans for patients. The information generated by the laboratory will still be fundamental to the diagnostic and treatment process but will be complemented by information from distinct, independent sources.Information technology is both the barrier and the solution. Just about everybody who has an ATM card can travel anywhere in the United States and obtain cash from their account. It may cost from \$1 to \$3 to get it, but the days of carrying travelers' checks are gone. Why is it that I can take my ATM card and get cash just about anywhere in the world, but I cannot get my medical record anywhere else? What the banks have been able to do, we should be able to do. At this conference, General Electric (Fairfield, Conn), Siemens Medical Solutions USA, Inc (Malvern, Pa), and IBM (Armonk, NY) all predict a greater penetration of technology and informatics into pathology. The key to the information technology solution is going to be operationalizing what we have seen at this conference. Technologic innovations will happen and the drivers are readily apparent. The trends are clear toward earlier, more actionable information increasingly dependent upon underlying data. Digital pathology is coming; get ready for it. Someone eventually is going to get paid for doing what we are doing with new tools. If you are not ready for it, somebody else will get paid for it. It will be done and the key is going to be in the change management and the leadership.The key to surviving the technology transition is providing diagnostic information across the fields. This is the one area where those groups in competition with the large national reference laboratories have a potential critical advantage. The national laboratories do not have a lot of the technologies resident in most hospital systems. They do not have a longitudinal patient record, with clinical histories, imaging databases, historical laboratory results, previous tissue specimens, serial data, and so forth. What they do have is a disconnected series of unique “N = 1” encounters. They may be deep, but they are not broad, and that is where hospital-based laboratories can compete on favorable terms.Curiously, the only people who care about a distinction between anatomic and clinical are pathologists. The divisions of pathology, anatomic and clinical, have merged. We should get over the hang-up about the distinction. The average physician wants assistance in making the diagnosis, and he or she does not care whether a specimen is analyzed on a hematology machine, a chemistry machine, or a urinalysis machine. He or she is not interested in whether the doorway banner is labeled microbiology, molecular pathology, cytology, or anatomic pathology. To the average physician, these are purely internal issues. From one perspective, the only differences between anatomic and clinical pathology are that one usually has a screw top on a specimen jar and the other one has a push top on a vacuum tube. From the clinical provider's point of view, he or she is sending something to our front door, and we are doing something scientific to it, perhaps providing a clinical interpretation, and getting a report back to him or her. This is also why many think of pathology and radiology as similar, the biggest difference being whether protons, electrons, impedance waves, or photons are passed through the specimen, and whether the object is an entire patient or only part. In either case, the doctor who is with the patient primarily wants help with finding the answer. Consequently, the prediction is that the distinction between anatomic and clinical pathology will disappear, if it has not done so already among many of our medical brethren.Disruptive technologies are those that can change an entire field or industry. Thirty years ago, CT scanning disrupted radiology. Fifteen years ago, digital imaging further disrupted radiology. More recently, radiologists took a CT scan and a PET scan, overlaid the images, and started talking about convergence imaging. They devised a method to not only see a mass but to see if it was metabolically active. Radiology has been irretrievably altered by these technologies.Pathology has been slower to evolve, in large part due to the greater digital bandwidth required and processing demands of our imagery. In the past 20 years, pathology has seen disruptions from immunohistochemistry and flow cytometry. The diagnostic disruptions of the future will also come from combined modalities. The holy grail of molecular imaging and in vivo diagnosis requires development and validation of cross-discipline biomarkers.Medicine clearly believes that most diseases have a greater chance of cure if recognized, diagnosed, and treated early. Ideally, cancer would be diagnosed and treated as easily as a localized infection, requiring only a small, easily obtained specimen to be sent to the laboratory, resulting in a rapid, specific diagnosis including drug sensitivities specific for the individual patient and his or her disease. For the convenience of the patient, most if not all of the encounter would be in the outpatient setting. Diseases that are not “curable” would be converted to chronic disease. For example, to the extent that congestive heart failure is not entirely reversible, the diagnostic and treatment plan would be a long-term management plan to effectively delay death due to disease. This chronic disease management would likely require and the for the laboratory. As of disease and are the laboratory will likely be upon to provide that diagnosis of in is not going to be by a CT scan diagnosis is from images of vivo tissue, which has in common with the in Someone some will need to the data between the pathology images and the data from the in vivo imaging There will be and the of drug development and are for I expect that the real advances will come with the of a true that not just into a computer but rather processing across and across data into information at that is going to have the disruptive technology that is going to not only pathology but the world of we are about what the future we can be more about what the future is of will not be by the greatest tool to has some but from being far too The of a does not with infection, and can be by If the laboratory were to the average what he or she would like to see in a the would be that he or she is far with what the is as as what specific it. That information is still not and readily available by The future is not in The future is not in The future is not 88305 The pathologist is an of the 88305 reimbursement code will see a