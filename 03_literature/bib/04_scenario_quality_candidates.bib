@article{she2024integrated,
  title = {{An Integrated Design Methodology for Architecture Solutions to Shimmy Reduction Subsystems in All Electric Aircraft}},
  author = {She, Chenfei and Zhang, Ming and Hinkkanen, Marko and Yang, Yu},
  journal = {IEEE Transactions on Transportation Electrification},
  year = {2024},
  volume = {10},
  number = {4},
  pages = {10428--10440},
  doi = {10.1109/tte.2024.3376973},
  url = {https://doi.org/10.1109/tte.2024.3376973},
  abstract = {This paper investigates the search for architecture solutions to a novel shimmy reduction subsystem in the nose wheel steering system (NWSS) of all electric aircraft (AEA). Since the traditional trial-and-error and empirical methods are inefficient and infeasible in this study, respectively, a new methodology for system architecture design is needed. The integrated methodology combines the systems engineering engine method and V-model to explore the design space of the shimmy reduction subsystem, defines the parameters of the low-level product using general morphological analysis (GMA), eliminates incompatible alternatives through cross-consistency assessment (CCA), and, after morphological analysis, subjects the solutions that satisfy the optimal design set to a single-objective decision based on cost-effectiveness analysis (CEA). Furthermore, a product realization of the final selected design solution is presented, along with the implementation and verification processes. The methodology deals with the problem in the design of the shimmy reduction subsystem in AEA.},
  keywords = {04_scenario_quality; candidate: general morphological analysis cross consistency assessment},
  note = {OpenAlex W4392745335; cited_by 11; abstract_source openalex}
}

@article{hlaing2025artificial,
  title = {{Artificial Intelligence‐Driven Automated Design of Anterior and Posterior Crowns Under Diverse Occlusal Scenarios}},
  author = {Hlaing, Nan Hsu Myat Mon and Çakmak, Gülce and Karasan, Duygu and Kim, Sung‐Jin and Sailer, Irena and Lee, Jae‐Hyun},
  journal = {Journal of Esthetic and Restorative Dentistry},
  year = {2025},
  volume = {38},
  number = {1},
  pages = {129--142},
  doi = {10.1111/jerd.70029},
  url = {https://doi.org/10.1111/jerd.70029},
  abstract = {OBJECTIVE: To evaluate the impact of occlusion type and artificial intelligence-based computer-aided design (CAD) software on the geometric accuracy and clinical quality of auto-generated anterior and posterior crown designs. METHODS: Five typodont models representing various occlusion types (normal, Class I anterior diastema, Class II division 1, Class II division 2, and Class III anterior crossbite occlusion) underwent crown preparation for the maxillary right central incisor and first molar. Ten sets of intraoral scans were obtained from each prepared model, and crown designs were automatically generated using two software programs: deep learning-based (DL; Dentbird) and conventional automated (CA; Auto Workflow, 3Shape) (n = 10). Surface deviations between the crown designs and preoperative tooth morphology were quantified using root mean square (RMS) values. Clinical crown quality was assessed using World Dental Federation (FDI) criteria. Scheirer-Ray-Hare and Fisher's exact tests were conducted (α = 0.05). RESULTS: Significant differences in surface deviation and clinical quality were observed between the various occlusion and software types. The DL group demonstrated higher RMS values than the CA group (p < 0.001). However, DL-generated crowns were of significantly better clinical quality (FDI scores) than CA-generated crowns, particularly for posterior teeth, in terms of marginal adaptation, proximal contacts, and anatomical form and contour (p < 0.05). The DL group demonstrated generally favorable outcomes when designing crowns for normal occlusion, but outcomes were less satisfactory when designing anterior crowns with diastemas. CONCLUSIONS: Occlusal scenarios influenced the surface deviation and quality of auto-generated anterior and posterior crown designs. DL software produced higher-quality molar designs than CA software. CLINICAL SIGNIFICANCE: Automated crown design outcomes depend on occlusal scenarios and CAD software selection. DL-based CAD software demonstrated superior clinical quality, particularly for posterior crowns, indicating higher clinical suitability. However, further software refinement is needed to consistently produce clinically acceptable crowns under diverse occlusal conditions, such as anterior diastemas.},
  keywords = {04_scenario_quality; candidate: consistent scenario set selection morphological},
  note = {OpenAlex W4414017667; cited_by 9; abstract_source openalex}
}

@article{riggle2006using,
  title = {{Using Entropy to Learn OT Grammarsfrom Surface Forms Alone}},
  author = {Riggle, Jason},
  year = {2006},
  pages = {346--353},
  url = {https://openalex.org/W2512372914},
  abstract = {The problem of ranking a set of constraints in Optimality Theory (Prince and Smolensky 1993) in a fashion that is consistent with an observed training sample comprised of 〈input, output〉 pairs has been solved with a variety of algorithms (e.g. Tesar 1995; Tesar and Smolensky 1993, 1996, 1998, 2002; Boersma 1997; Boersma and Hayes 2001). In real-world language learning scenarios, however, learners aren’t usually presented with 〈input, output〉 pairs but must instead learn grammars from output forms alone (possibly aided by conjectures about their meanings or morphology). The task of learning OT grammars from training samples that consist of output forms alone presents many challenges. Chief among these is the problem that there are often many 〈possible-input, possible-grammar〉 pairs that are consistent with any observed training sample of surface forms. For instance, the fully faithful ‘identity grammar’ is a perennially viable hypothesis under which the input forms are assumed to be basically identical to the observed output forms. In addition to this hypothesis, depending on the particular constraints in CON and the specific surface forms in the training sample, there are a potentially huge number of other 〈grammar, i/o-mapping-set〉 pairs, each one deriving a different set of unfaithful mappings from potential input forms to the outputs in the training sample. Knowledge of meaning and morphology can help the learner choose grammar hypotheses that map the same input to different surface instantiations of the same morpheme. But, even before the learner has any knowledge about the morphology and meanings of words, it is possible to make educated guesses about the structure of the grammar. Suggested strategies for this include principles like Prince and Tesar’s (1999) selectional preference for ranking hypotheses that are maximally ‘restrictive’ or Smolensky’s (1996) default MARKEDNESS >> FAITHFULNESS ranking. Both of these strategies restrict the search through the space of possible grammars by providing a heuristic that’s designed to prefer rankings that generate a tight fit with the observed data. In this paper I present yet another strategy for adjudicating among competing grammar hypotheses without recourse to morphological information or meanings. The strategy that I propose is not based on formal properties of the constraint rankings themselves, but instead is based on informationtheoretic properties of the set of inputs that each candidate grammar (ranking) associates with the training sample. The idea is this: if learners choose grammars whose associated input sets have the highest entropy (are least ordered) they will select grammars that maximally characterize patterns in the training sample as consequences of the grammar rather than as accidents of the lexicon.},
  keywords = {04_scenario_quality; candidate: consistent scenario set selection morphological},
  note = {OpenAlex W2512372914; cited_by 8; abstract_source openalex}
}

@article{farrar2016vittaria,
  title = {{Vittaria appalachiana continues to provide insight into the biology of ferns: A commentary on two studies recently published in American Journal of Botany}},
  author = {Farrar, Donald R.},
  journal = {American Journal of Botany},
  year = {2016},
  volume = {103},
  number = {4},
  pages = {593--595},
  doi = {10.3732/ajb.1500323},
  url = {https://doi.org/10.3732/ajb.1500323},
  abstract = {The gametophyte generation plays a critically important, but often underappreciated, role in driving fern evolution through site selection and thus distribution and population differentiation. Chambers and Emery (2016) investigated population differentiation using the gametophyte generation of a fern species, Vittaria appalachiana, because of its well-studied history and the unusual opportunities it presents for analysis of selection and adaptation to climate change. On the basis of previously demonstrated genetic variation among populations, they predicted physiological variation among populations across the species' range in response to environmental gradients. Geological as well as biological evidence argues strongly for an ancient (pre-Pleistocene) origin of V. appalachiana in its current habitats, and because the species no longer reproduces via spores, the possibility of gene flow among distant populations is greatly reduced, thus presenting the ideal opportunity to test for ancient and possibly continuing, selection and adaptation to changing climates. The Chambers and Emery study further demonstrated the utility of V. appalachiana as a research tool for investigating the fundamental role of the gametophyte generation in fern ecology, migration, and evolution. Vittaria appalachiana and similar taxa are profoundly altering the basic concepts of fern gametophytes as traditionally presented in textbooks and beginning biology coursework. In the remainder of this commentary, I present a deeper context within which to appreciate the contributions of the Chambers and Emery study. I briefly summarize the history of V. appalachiana studies and explore relationships between morphological adaptations in fern gametophytes, reproductive biology, and migration of ferns. Finally, I consider the exploratory role of the gametophyte generation as a hedge against climate change. Vittaria appalachiana, long known as the Appalachian Vittaria gametophyte, was first noted as probably the gametophyte generation of a fern by E. T. Wherry (1942). It was introduced as a species of Vittaria on the cover of Science in 1963 as a “remarkably reduced vascular plant” as described by Wagner and Sharp (1963). Long before its appearance in Science, the Appalachian Vittaria gametophyte was well known by bryologists who explored its dark mossy habitats. It was often found in large, dense colonies covering a meter or more of dark rock walls where rare bryophyte species were sought. It appeared superficially similar to liverworts, but did not match any known species. The bryologists suspected that it might be the gametophyte stage of a fern, but that possibility drew little interest from pteridologists until noted bryologist A. J. Sharp was able to show massive colonies of the plant to W. H. Wagner. With help from fern gametophyte specialist Alma Stokey, they were able to establish its likeness to gametophytes of the fern genus Vittaria. The Appalachian Vittaria gametophyte acquired its formal name of Vittaria appalachiana Farrar \& Mickel (Farrar and Mickel, 1991), as the first fern species to be formally recognized on the basis of gametophytes only. Vittara appalachiana is a fern that exists in only one-half of the normal fern life cycle, and that half is the fingernail-sized gametophyte (gamete producing) stage. But instead of producing gametes (sperm and eggs that unite to produce the more familiar “fern-like” sporophyte stage), V. appalachiana gametophytes produce only more of themselves, via gemmae, locally dispersible strings of vegetative cells. Yet, despite the absence of sporophyte plants (and thus the inability for wide dispersal via spores), V. appalachiana exists in abundance from Alabama to New York and from Indiana to North Carolina, a distribution pattern common to many of our “normal” eastern ferns. How this extensive range could have been achieved has been the source of much speculation. Related species of Vittaria occur in the American tropics, so perhaps spores of V. appalachiana could have arrived from that source. DNA sequencing of the Appalachian plants suggest a sister (Crane, 1997) or conspecific (Pinson and Schuettpelz, 2016) relationship with tropical V. graminifolia in Central America, but discrepancies in morphology between the gametophytes of these two taxa, especially in their gemmae, is problematic. Also at odds with a simple derivation from V. graminifolia are allozyme profiles (Farrar, 1978, 1990) expressing allelic heterozygosity indicative of diploidy rather than the haploid condition expected in a gametophyte. The observed chromosome number of 120 in V. appalachiana (Gastony, 1977) is a diploid number that could have resulted either from a tetraploid sporophyte (2n numbers of both 120 and 240 have been reported for V. graminifolia sporophytes by Smith and Mickel [1977]) or possibly from a diploid sporophyte producing unreduced diploid spores. Derivation from a tetraploid sporophyte could better explain genetically based differences among populations evidenced in the study by Stevens and Emery, as well as allelic variability among populations demonstrated by Farrar (1990). Conversely derivation from a diploid sporophyte would better explain the observations of apogamous outgrowths (3-dimesional structures resembling embryonic sporophytes) in some wild populations and some cultures (Farrar, 1978). In an apogamous gametophyte + sporophyte life cycle, diploid gametophytes differentiate vegetatively into diploid sporophytes that produce diploid spores unreduced in chromosome number by meiosis. Such asexual reproductive strategies are not uncommon in ferns (Gastony, 1986). In either case, spores, dispersed by wind, could have established the current distribution of V. appalachiana. But if this is the explanation for the distribution of V. appalachiana, where are those spore-producing plants now? A probable answer is evidenced by the northern boundary of the distribution of V. appalachiana that parallels the southernmost boundary of Pleistocene glaciation (Farrar et al., 1983). Habitats supporting community associates of V. appalachiana, and appearing similar to those supporting V. appalachiana to the south, continue well north of glacial limits, but in these habitats V. appalachiana is conspicuously absent. Recent transplant studies have found that V. appalachiana survives as well in these unoccupied northern sites as transplants to sites south of glaciation (Stevens and Emery, 2015). Together, these observations, plus evidence from associated species (Farrar, 1998), suggest a broader pre-Pleistocene distribution of V. appalachiana that became truncated by glaciation that also changed eastern North America to a temperate climate in which V. appalachiana sporophytes could not survive. Without the aid of spores, V. appalachiana was unable to regain its northern extension or to have interaction of any kind among distant populations. The scenario of a pre-Pleistocene tropical or subtropical V. appalachiana with a spore-producing life cycle achieving a wide distribution in eastern North America, then being subjected to the depredations of Pleistocene climate change with only the gametophyte surviving for thousands of years (or more), sets a stage for extremely interesting investigations. How did the species adapt to such drastic climate changes physiologically, genetically, morphologically, and ecologically? Unlocking these secrets held by V. appalachiana is a daunting challenge, but offers rewards unmatched by other species. Initially, the phenomenon of the Appalachian Vittaria gametophyte seemed an interesting curiosity, probably without much relevance to the basic biology and evolution of ferns. That opinion has been modified considerably through continuing investigation. The second appearance of V. appalachiana in the pages of Science occurred when it was discovered that not just this species, but independent gametophytes of three additional fern genera existed in the southern Appalachian Mountains (Farrar, 1967). As with V. appalachiana, they existed primarily or solely as gametophytes, producing, at most, juvenile sporophytes that never reached spore-producing size. They too depended on gemma production for their continued existence and had their closest relatives in tropical or subtropical areas. None of these four taxa has yet been completely matched with any tropical species, although some intriguing relationships have been detected (Ebihara et al., 2008). Vegetative reproduction by gametophytic gemmae has undoubtedly served all of these Appalachian species well in maintaining populations, over extended time, in temperate habitats apparently unsuitable to their sporophyte counterparts. Is there a role for this type of gametophytic perenniality in tropical habitats where related species typically maintain a sexual alternation of gametophyte and sporophyte stages? Could there be a more broadly adaptive value of gametophyte gemmae? Insight into these questions was presented in the third appearance in Science of species of Vittaria, this time showing that gemmae, in addition to vegetative reproduction, could act as locally dispersible male plants (Emigh and Farrar, 1977). Based on the finding of antheridium-bearing gemmae at the base of large mature gametophyte plants in field populations of V. appalachiana, controlled culture experiments with gametophytes of V. lineata and V. graminifolia (tropical American species with gametophytes more amenable to culture) showed that secretions from mature gametophytes (antheridiogens) and gibberellic acid (chemically similar to native antheridiogens) could induce gemmae to immediately produce antheridia rather than the vegetative growth produced by gemmae grown outside the influence of mature gametophytes (Emigh and Farrar, 1977). Dispersable gemmae with the capacity for antheridium production could thus promote cross fertilization between genetically different gametophyte clones, especially in epiphytic habitats where these clones may occupy different limbs where they could not otherwise interact (Dassler and Farrar, 1997). Additionally, perenniality of clones could increase the time window for cross fertilization between clones established by later arriving, genetically different spores, thus avoiding the genetic bottleneck faced by isolated short-lived gametophytes with only the option of gametophyte selfing for production of a sporophyte. Testing the hypothesis that species with perennial gametophytes and gemma might hold migration advantages over species with short-lived gametophytes, Dassler and Farrar (2001) compared the number of species in each category occurring in isolated islands vs. the probable mainland sources of spores founding the island floras. In island-mainland sets across tropical oceans, the percentage of species with perennial and gemma-producing gametophytes was found to be consistently greater in islands. Because this study did not discriminate between founding species and new island species derived from the founding species, it does not clearly answer the question of whether the biology of perennial gametophytes with gemmae confers an advantage in initial colonization or in subsequent speciation capabilities. However, both aspects of colonization can reasonably be attributed to the high genetic variability that can be maintained in the gene pool of species with gemmiferous perennial gametophytes through interaction of migrants arriving at different times. The Appalachian Vittaria gametophytes also dispelled the notion of fern gametophyte as delicate plants conferring a “weak link problem” to the fern reproductive strategy. Early studies on tolerance of V. appalachiana and related tropical species to freezing and desiccation demonstrated that the gametophytes have greater tolerance than do their sporophyte counterparts (Farrar, 1978). A number of studies have now shown gametophytes of many species of ferns to be remarkably tolerant of desiccation (Watkins et al., 2007), and gametophytes of temperate ferns established in late fall regularly overwinter subfreezing conditions (Farrar and Gooch, 1975; Sato and Sakai, 1981). These observations, combined with expanded detection of species existing as gametophytes beyond the range of their sporophytes (made possible by barcode identification of gametophytes [Chen et al., 2013; Ebihara et al., 2013]), is forcing a reconsideration of the role of the gametophyte generation in exploring new habitats, especially if they have the capacity for long-term persistence. Environmental change demands migration or adaptation. Continued research on the role of the gametophyte generation in shaping fern migration, adaptation, and evolution is critical.},
  keywords = {04_scenario_quality; candidate: consistent scenario set selection morphological},
  note = {OpenAlex W2331811010; cited_by 8; abstract_source openalex}
}

@article{papathanassis2013short,
  title = {{‘Short of a Picnic?’: Reconsidering sandwich-programmes in cruise education}},
  author = {Papathanassis, Alexis and Matuszewski, Imke and Havekost, Kai},
  journal = {Journal of Hospitality Leisure Sport \& Tourism Education},
  year = {2013},
  volume = {13},
  pages = {47--59},
  doi = {10.1016/j.jhlste.2013.05.001},
  url = {https://doi.org/10.1016/j.jhlste.2013.05.001},
  abstract = {Internships are regarded to be essential and complementary to cruise (and tourism) curricula. Yet, their relevance remains largely unquestioned. This paper aims at exploring the internship-related perceptions of: cruise-employers, students and educators, whilst highlighting and interpreting potential misalignments. Our methodological paradigm is explorative-qualitative, utilising primarily content analysis complemented by semi-structured interviews. Students’ perceptions are derived through a systematic coding of 34 internship reports, whilst those of educators and employers extracted by 15 semi-structured interviews. General morphological analysis and cross-consistency assessment were applied to compare the different worldviews, followed by a discussion of implications and recommendations for tourism/cruise curricula.},
  keywords = {04_scenario_quality; candidate: general morphological analysis cross consistency assessment},
  note = {OpenAlex W2073280098; cited_by 8; abstract_source openaire}
}

@article{bradley2018century,
  title = {{A century of mammal research: changes in research paradigms and emphases}},
  author = {Bradley, Robert D. and Dowler, Robert C.},
  journal = {Journal of Mammalogy},
  year = {2018},
  volume = {100},
  number = {3},
  pages = {719--732},
  doi = {10.1093/jmammal/gyy147},
  url = {https://doi.org/10.1093/jmammal/gyy147},
  abstract = {This manuscript presents a comparison of research paradigms and emphases during the first century of formalized mammalogy in North America. To accomplish this task, it became necessary to investigate not only the transformations in “research methods” (techniques or technological advances) over the last 100 years, but to address the evolution of the “state-of-the-science” (new and shifting paradigms, more sophisticated hypotheses, and origin of new subdisciplines). As we constructed this chapter, it became apparent that in many cases, these two areas were intertwined and typically dependent on each other. For example, the advent of new technologies often allows the testing of more sophisticated hypotheses, which then leads to the next generation of research methods, hypotheses, and so on. Consequently, although our goal was to treat “methods” and “paradigms” as separate foci, it became necessary, on occasion, to discuss the two simultaneously. We have organized our chapter into three sections. The first section pertains to “Changes in Emphases and Paradigms.” There, we describe how mammalogy changed from a purely descriptive and exploratory process to one that became more taxonomically focused in scope and more narrowly directed at testing specific hypotheses. This section also includes a discussion of how “integrated approaches” (multi-authored research endeavors and multiple data sets) and the evolution of “species concepts” changed the science of mammalogy. The second section, “Advancements in Research Methods as a Result of New Technology,” addresses the changes in equipment, techniques, and data analyses, and ultimately, how these innovations impacted the science of mammalogy. In the third and final section, “Literature Review,” we contrasted manuscripts that were published in the Journal of Mammalogy during the first 10 years of its existence (1919–1928) and middle 10 years (1960–1969) to manuscripts that appeared more recently (2007–2016). We categorized manuscripts into various disciplines to see if activity in those disciplines remained constant since the inception of the Journal of Mammalogy. Further, by using manuscripts that were published in the Journal of Mammalogy during these three time frames, we hoped to identify the types of “mammalogy” that the American Society of Mammalogists, through its Editorial Board, reviewers, and membership (those submitting manuscripts), considered “acceptable and contemporary mammalogy.” For much of our chapter, we drew heavily upon previous contributions that appeared in Seventy-five Years of Mammalogy (1919–1994) edited by Elmer C. Birney and Jerry R. Choate (Birney and Choate 1994). In particular, the section entitled “Intellectual Development of the Science of Mammalogy” proved extremely useful in preparing a synopsis of how mammalogy has advanced as a science during its first century as a professional discipline. Other sources such as Going Afield (Phillips and Jones 2005), United States Biological Survey: A Compendium of its History, Personalities, Impacts, and Conflicts (Schmidly et al. 2016) and A Timeline of Significant Events in the Development of North American Mammalogy (Schmidly et al. 2017) proved invaluable in our endeavor to reconstruct the science of mammalogy of previous generations and to dissect the events that would shape current research in the discipline. From the late 1800s to the middle part of the 20th century, mammalogy was dominated by specimen-based and field-based research. For much of this period, mammalogy was a descriptive science with little, if any, commitment to hypothesis-based research. In many ways, this is not surprising and should not be considered as a negative connotation to the quality of mammalogy as a science during its onset. It was simply the state-of-the-discipline at a given point in time, and as with most scientific endeavors, these early descriptive and specimen-based studies (range distributions, taxonomic treatments of species and subspecies, natural history characteristics, etc.) provided the data for later (contemporary) discussions about phylogeography, vicariance, dispersal, speciation, and a myriad of other factors that have influenced the mammalian diversity of North America. Further, modern genetic methods (e.g., mtDNA, microsatellites) and analytical approaches such as phylogeography have challenged these ideas and in some cases strengthened the early arguments and positions. Three obvious factors appear to have contributed to the descriptive nature of the early years of mammalian research in North America. First, one could surmise that the personalities of Merriam’s men and the Merriam’s during the of the of Biological the of mammalogy as a science at the time of the of the or the of the 2016) was to the North American and distributions, of and and and given a in of taxonomic a was on that many of the of the the of the through as of the and of the Journal of Mammalogy a on specimen-based and field-based research. were and to at this Merriam’s were more or a of the In a a for how field-based research was to be and at the that remained for was by that a in the early of mammalogy as or by the to a more descriptive to the and typically were in As C. and of at the in as by it is not to see this on mammalogy. Further, those as by not in the as the by at the of at to and the United States by research the of North American during the late 1800s and early that was necessary to a of North American as as to a scope of and As by et al. of North was a natural of of the The of and Mammalogy and the were the first to to this for taxonomic The not only to of but many of the first on the natural and of in the United and In the North American as for studies and data that from the the of the at the a taxonomic and data was for of North and as as for some of the of et al. for a the at by and other and American of to to studies of mammalian these studies remained the to from studies of a