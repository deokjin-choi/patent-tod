  author = {Jang, Kyu-Nam and Lee, Young Ho and Kim, Young Jin and Kim, Youngwook and Park, Myungsoon},
  journal = {대한산업공학회 춘계공동학술대회 논문집},
  year = {2007},
  pages = {528--534},
  url = {https://openalex.org/W2114867320},
  abstract = {This paper structures the innovation opportunity identifying process which is based on chain link model. Innovation opportunity identification is a part of the technology management process such as identification, selection, acquisition, development, exploitation and protection of technologies. It is however, a very important part since the identification decision has to take a forward view of how the identified technology might impact the process of selection, acquisition, development, exploitation and protection. Proposing process finds out technology theme in market-oriented search by scenario analysis and morphology analysis on business models. And also our process finds out prospective technologies in technology-oriented search by technology scanning and patent analysis. Our process identifies innovation opportunities by mapping technology themes and prospective technologies, and derive innovation portfolio by evaluating technology risk. We search innovation opportunities in this process in aging society trend for pilot study.},
  keywords = {01_tmo_morphology; candidate: patent morphology analysis technology opportunity},
  note = {OpenAlex W2114867320; cited_by 0; abstract_source openalex}
}

