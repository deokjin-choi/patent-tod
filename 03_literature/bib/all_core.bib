  doi = {10.1016/j.techfore.2021.121413},
  url = {https://doi.org/10.1016/j.techfore.2021.121413},
  keywords = {02_kg_embedding; core},
  note = {OpenAlex W4200455899; cited_by 49; abstract_source none}
