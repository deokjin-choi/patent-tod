{
  "publication_number": "CN114785810A",
  "title": "Tree broadcast data synchronization algorithm suitable for federal learning",
  "assignee": "Hainan Normal University",
  "filing_date": "2022-03-31",
  "publication_date": "2022-07-22",
  "pse": {
    "problem": "Increased synchronization time, bandwidth pressure on central server, and lack of scalability in traditional federated learning model synchronization process",
    "solution_function": "Tree-based broadcast data synchronization algorithm distributes model files among participating clients and verifies their integrity to reduce synchronization time, stabilize bandwidth occupancy, and improve scalability",
    "solution_structure": "Complete binary tree with central server as root node, clients as child nodes and leaf nodes",
    "solution_implementation": "Central server generates server information, splits global model file into seed files, calculates hash values, generates public/private key pairs, signs iteration configuration files, sends them to clients for verification and data exchange between clients",
    "effect": "Shortened federated learning data synchronization time, stabilized bandwidth occupancy, and improved scalability of participant scale and model training efficiency"
  },
