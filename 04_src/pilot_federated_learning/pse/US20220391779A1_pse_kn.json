  "title": "Systems and methods for reward-driven federated learning",
  "assignee": "JPMorgan Chase Bank NA",
  "filing_date": "2022-06-01",
  "publication_date": "2022-12-08",
  "pse": {
    "problem": "Privacy preservation and lack of fair incentivization in federated learning",
    "solution_function": "Reward-driven federated learning for fair distribution of rewards to model contributors based on their contributions to the current global machine learning model.",
    "solution_structure": "A federated node with a federated contribution computer program, distributed ledger network, clients, and local machine learning models.",
    "solution_implementation": "The federated contribution computer program receives local machine learning model updates from clients, calculates the current global machine learning model based on these updates, determines each client's federated contribution, issues rewards to clients, and refuses updates from low-contributing clients.",
    "effect": "Improved privacy preservation, fair incentivization, and potential increase in contributions from individual nodes"
  },
