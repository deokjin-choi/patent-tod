{
  "publication_number": "CN118940310A",
  "title": "A privacy-preserving quantitative federated learning approach",
  "assignee": "Nantong University",
  "filing_date": "2024-07-12",
  "publication_date": "2024-11-12",
  "pse": {
    "problem": "Limited resources in intelligent Internet of Things (IoT) devices for deep learning neural network operations, including computing power, storage capacity, battery service life, bandwidth, and privacy protection during data transmission of model parameters or gradients.",
    "solution_function": "A quantized federal learning method that addresses resource constraints by compressing models through quantization and ensuring privacy protection via differential privacy, homomorphic encryption, and secure multiparty computing. The method involves locally training on devices, aggregating local model parameters at a central server, and performing arithmetic operations without decrypting data to protect privacy.",
    "solution_structure": "IoT devices: low power embedded processors, limited memory and storage; Central Server: responsible for aggregating and updating the global model.",
    "solution_implementation": "Model compression through quantization of floating point representation to a low bit representation; Privacy protection through differential privacy (Laplace or Gaussian noise), homomorphic encryption, and secure multiparty computing (data division between multiple encrypted portions).",
    "effect": "Reduced resource consumption in IoT devices due to model compression and improved privacy protection during data transmission of model parameters or gradients."
  },
