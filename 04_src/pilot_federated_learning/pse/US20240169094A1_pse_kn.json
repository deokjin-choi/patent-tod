{
  "publication_number": "US20240169094A1",
  "title": "Mitigating private data leakage in a federated learning system",
  "assignee": "Intel Corp",
  "filing_date": "2022-11-23",
  "publication_date": "2024-05-23",
  "pse": {
    "problem": "Private data leakage in a federated learning system when model parameters are sent back to a centralized server",
    "solution_function": "A system that improves data privacy by training a local model on each client device, exchanging encrypted model updates with the central server, and verifying data privacy at the server before aggregating the updates",
    "solution_structure": "Client devices (e.g., smartphones, tablets), central federated server, encrypted communication channels, privacy checking logic",
    "solution_implementation": "Local model training on client devices, encryption of model updates, transmission of encrypted updates to the server, privacy checking at the server, decryption and aggregation of valid updates",
    "effect": "Reduced risk of private data leakage and enhanced data privacy protection"
  },
