{
  "publication_number": "US20230102732A1",
  "title": "Privacy-preserving data curation for federated learning",
  "assignee": "Siemens Healthineers AG",
  "filing_date": "2021-09-28",
  "publication_date": "2023-03-30",
  "pse": {
    "problem": "Limited access to large, diverse healthcare datasets due to regulatory concerns over sharing sensitive data",
    "solution_function": "Federated learning approach enables multiple collaborators to train a machine learning model without sharing sensitive data. Collaborators receive global model parameters from a parameter aggregation server, acquire and anonymize sample data, and transmit local model parameters for the model back to the parameter aggregregation server after training on validated sample data.",
    "solution_structure": "The system consists of multiple collaborators, a curation server, and a parameter aggregation server.",
    "solution_implementation": "Collaborators anonymize their sample data and submit it to the curation server for validation. The curation server identifies valid data samples based on predefined conditions, while a machine-trained model is used by some collaborators to identify invalid samples. Collaborators train their models using validated sample data and transmit local model parameters back to the parameter aggregation server.",
    "effect": "Improved data privacy and reduced data movement in distributed machine learning scenarios"
  },
