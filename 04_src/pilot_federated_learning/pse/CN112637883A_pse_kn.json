{
  "publication_number": "CN112637883A",
  "title": "Federal learning method with robustness to wireless environment change in power Internet of things",
  "assignee": "State Grid Information and Telecommunication Group Co Ltd",
  "filing_date": "2020-12-09",
  "publication_date": "2021-04-09",
  "pse": {
    "problem": "Limitation in implementing powerful machine learning solutions due to latency, bandwidth, privacy, and data isolation issues in wireless edge networks",
    "solution_function": "Federated learning method robust to wireless environment changes: Collects and processes training data from multiple User Equipment (UEs), trains a neural network model locally on each UE, aggregates the weights of trained models at an Access Point (AP), and updates global federated learning model based on aggregate weights",
    "solution_structure": "Neural Network Model, Weight Parameters, User Equipment (UEs), Wireless Access Point (AP)",
    "solution_implementation": "Local training on UEs, aggregation of weight parameters at AP, simulation of wireless environment factors, analysis of convergence performance, and selection of client for federated learning",
    "effect": "Robust federated learning solution that reduces latency, bandwidth requirements, and privacy concerns while utilizing isolated data sources"
  },
