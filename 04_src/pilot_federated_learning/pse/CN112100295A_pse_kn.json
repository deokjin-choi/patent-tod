{
  "publication_number": "CN112100295A",
  "title": "User data classification method, device, equipment and medium based on federated learning",
  "assignee": "Ping An Technology Shenzhen Co Ltd",
  "filing_date": "2020-10-12",
  "publication_date": "2020-12-18",
  "pse": {
    "problem": "The current method for classifying user data based on federated learning shares training data with the central server, posing a risk of user data leakage.",
    "solution_function": "The invention proposes a method that protects user privacy data by generating a gradient matrix during each training cycle, selecting the target channel and gradient matrix, using the selected gradient matrix as the weight of the server to update the local model, and classifying user data based on the updated local model.",
    "solution_structure": "The solution includes training data, a local model, a gradient matrix, a tensor for saving calculation results, and a channel selection threshold.",
    "solution_implementation": "The process involves obtaining training data, parsing user data, training the local model with the training data, generating a gradient matrix based on the change gradient of the weight matrix during each training cycle, selecting the target channel and gradient matrix, using the selected gradient matrix as the weight of the server to update the local model, and classifying user data based on the updated local model.",
    "effect": "The proposed method improves the security of user privacy data by reducing the risk of user data leakage."
  },
