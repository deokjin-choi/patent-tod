{
  "publication_number": "CN118014057A",
  "title": "Cloud and fog edge cooperation-based joint learning model construction method",
  "assignee": "University of Electronic Science and Technology of China",
  "filing_date": "2024-03-05",
  "publication_date": "2024-05-10",
  "pse": {
    "problem": "Inefficient and secure deployment of large AI models in lightweight devices and vertical field applications",
    "solution_function": "Construction of a joint learning model that leverages the computational power of cloud servers and the response speed of edge devices for efficient, secure, and private machine learning",
    "solution_structure": "Deep neural network model, distributed federated learning model, edge nodes, fog nodes, central server",
    "solution_implementation": "1. Select training tasks and initialize deep neural network model and distributed federated learning model\n2. Collect data in real-time based on edge nodes\n3. Transmit the data to nearby fog nodes for processing\n4. Based on processed data and judgment conditions, choose between centralized deep neural network outsourcing authorization training or distributed federated learning training",
    "effect": "Reduced communication costs, improved training efficiency while maintaining data privacy"
  },
