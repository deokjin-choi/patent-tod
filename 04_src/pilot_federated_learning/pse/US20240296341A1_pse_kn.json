{
  "publication_number": "US20240296341A1",
  "title": "Apparatus and method for tackling data heterogeneity in federated learning using intermediate layer representation regularization",
  "assignee": "Kyung Hee University",
  "filing_date": "2023-11-15",
  "publication_date": "2024-09-05",
  "pse": {
    "problem": "Limitation in centralized training of deep neural network models due to security concerns and privacy regulations",
    "solution_function": "Collaborative model training among edge devices using Federated Averaging (FedAvg) algorithm to create a global model without sharing local data",
    "solution_structure": "Edge devices for data collection, each device with local model for training, central server for aggregating trained parameters and creating a global model",
    "solution_implementation": "Each edge device trains its local model using its own data, sends the trained parameter to the server, which then aggregates the received parameters into a single global model",
    "effect": "Enables large-scale distributed deep learning with data privacy preservation and potential for improved performance due to heterogeneous data"
  },
