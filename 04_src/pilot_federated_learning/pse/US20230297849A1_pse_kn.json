{
  "publication_number": "US20230297849A1",
  "title": "Federated learning method and device, and storage medium",
  "assignee": "Tencent Technology Shenzhen Co Ltd",
  "filing_date": "2023-05-24",
  "publication_date": "2023-09-21",
  "pse": {
    "problem": "Inefficient communication overhead and slow federated learning due to iterative adjustment process between a server and multiple devices.",
    "solution_function": "A federated learning method that determines candidate features from data, constructs multiple decision tree models based on the candidate features, selects the best model(s) based on prediction results, and transmits them to another device for fusion to obtain a federated learning model.",
    "solution_structure": "First computing device (server or participant): processor, memory. Second computing device: processor, memory.",
    "solution_implementation": "1. Determine candidate features from data features in the training dataset. 2. Obtain n first decision tree models using the candidate feature(s). 3. Determine at least one second decision tree model from the n first decision tree models based on their prediction results. 4. Transmit the second decision tree model to a second computing device for fusion.",
    "effect": "Reduced communication overhead, faster federated learning, and potentially improved model performance through selecting the best decision trees."
  },
