{
  "publication_number": "CN113515760A",
  "title": "Horizontal federal learning method, device, computer equipment and storage medium",
  "assignee": "Ping An International Smart City Technology Co Ltd",
  "filing_date": "2021-05-28",
  "publication_date": "2021-10-19",
  "pse": {
    "problem": "Data leakage during communication in a distributed machine learning scenario due to poor data transmission security.",
    "solution_function": "A horizontal federated learning method uses homomorphic encryption, homomorphic averaging processing, and model updating parameter calculation to protect privacy while combining trained model parameters from different nodes without revealing the original data.",
    "solution_structure": "The system consists of a main node and at least two participant nodes that communicate with each other. Each participant node possesses local data and a machine learning model.",
    "solution_implementation": "1. Participant nodes download the machine learning model (e.g., gradient boosting decision tree) from the main node, train it using local data to obtain trained model parameters. 2. Participant nodes perform homomorphic encryption on their trained model parameters and send encrypted data to the main node. 3. The master node performs homomorphic averaging processing on the encrypted data and sends the processed data back to each participant node. 4. Participant nodes decrypt the homomorphic averaged data, calculate the decrypted data based on a preset rule, remove interference data, and update the machine learning model with the obtained model update parameters.",
    "effect": "Improved data transmission security, reduced data leakage risk, and efficient use of storage space by avoiding duplicate data storage"
  },
