{
  "publication_number": "CN118940865A",
  "title": "Robust and efficient decentralized federated learning method and system based on committee consensus",
  "assignee": "Quancheng Provincial Laboratory",
  "filing_date": "2024-10-12",
  "publication_date": "2024-11-12",
  "pse": {
    "problem": "Privacy data disclosure risk in centralized machine learning due to data uploading",
    "solution_function": "Decentralization of machine learning through committee consensus using blockchain to replace the central server, increasing security and decentralization while reducing single-point failure and resource waste.",
    "solution_structure": "Blockchain network with participating nodes that perform workload certification or rights proving for consensus.",
    "solution_implementation": "Workload certification involves computation by nodes to compete for accounting rights, while rights proving competes for accounting rights based on node ownership. Bayesian robust federal learning algorithms such as TRIMMED MEAN and krum are used to resist malicious models.",
    "effect": "Improved privacy protection, increased system security, reduced resource waste, enhanced decentralization, and resistance to poisoning attacks"
  },
