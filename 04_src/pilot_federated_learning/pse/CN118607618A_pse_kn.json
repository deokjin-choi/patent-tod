{
  "publication_number": "CN118607618A",
  "title": "A federated learning method and system for parameter granularity adaptive frequency modulation",
  "assignee": "Shanghai Jiao Tong University",
  "filing_date": "2024-06-18",
  "publication_date": "2024-09-06",
  "pse": {
    "problem": "Inefficient federated learning due to limited client network resources, data distribution differences among edge devices, and high communication overhead.",
    "solution_function": "Adaptive frequency modulation of parameter granularity for improving training efficiency and reducing communication overhead while maintaining model accuracy.",
    "solution_structure": "Client network, federated learning system (aggregation server, selection module, update module), edge devices (local models).",
    "solution_implementation": "1. Selection Module: Selects a subset of clients for each round based on the data distribution and device capabilities. 2. Local Models: Train on local data using selected parameters from previous round. 3. Update Module: Aggregate updated model parameters from selected clients and send to all clients. 4. Aggregation Server: Distribute updated parameters and manage client selection.",
    "effect": "Improved training efficiency, reduced communication overhead, and optimal global model performance."
  },
