  "publication_date": "2020-11-20",
  "pse": {
    "problem": "Data leakage risk due to coordinator collecting individual participant's gradient values in federal learning process",
    "solution_function": "Fuses multiple encrypted gradient values from participants and sends the fused value to the coordinator for model update, ensuring data security of participants by preventing individual gradient values from being revealed",
    "solution_structure": "Comprises a first obtaining unit, second obtaining unit, fusion unit, sending unit, first storage module (optional), second storing module (optional), and third storing module (alternative)",
    "solution_implementation": "First obtaining unit gathers gradient messages from participants, second obtaining unit extracts individual gradient values, fusion unit merges the gradient values to form a target value, sending unit sends the target value to coordinator or stores it in a blockchain, third storing module temporarily saves gradient messages in a message queue (alternative)",
    "effect": "Improves data security by preventing data leakage and maintains federal learning process integrity"
  },
