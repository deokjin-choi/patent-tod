{
  "publication_number": "CN118469031A",
  "title": "Model training method and system among multiple IoT platforms based on federated learning",
  "assignee": "China Standard Intelligent Security Technology Co Ltd",
  "filing_date": "2024-03-28",
  "publication_date": "2024-08-09",
  "pse": {
    "problem": "Long model training cycle and low efficiency in federated learning across multiple IoT platforms due to heterogeneity of models among different manufacturers.",
    "solution_function": "The system collects data from multiple IoT platforms, pre-processes them as sample data. It migrates the teacher model's data to the student model. The student model exchanges and aggregates knowledge between multiple IoT platforms, using an aggregation algorithm to create a meta-model. The teacher model extracts features, maps them to an abstraction level, generates soft labels, and sends them to the student model for weight update.",
    "solution_structure": "Key components include personalized models (P-Model), knowledge exchange models (C-Model), meta-models (M-Model), data sets, feature extractors, abstraction layers, soft label generators, and gradient descent weight updaters.",
    "solution_implementation": "The teacher model performs feature extraction, mapping, soft label generation, and sends them to the student model. The student model calculates loss using the soft labels and updates its weights via gradient descent. Data preprocessing involves cleaning, duplicate removal, alienation, and data set replacement.",
    "effect": "Improved efficiency in federated learning across multiple IoT platforms by reducing the model training cycle."
  },
