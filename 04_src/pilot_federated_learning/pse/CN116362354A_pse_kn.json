{
  "publication_number": "CN116362354A",
  "title": "Missing completion method, device, node equipment and computer readable storage medium",
  "assignee": "Iflytek Huazhong Wuhan Co ltd",
  "filing_date": "2022-12-30",
  "publication_date": "2023-06-30",
  "pse": {
    "problem": "Lack of accurate methods for missing completion due to data privacy and export restrictions",
    "solution_function": "Performs longitudinal federated learning on local node device sample time series data and a specified model to obtain a federated target model. The model is used to generate an initial generator for missing completion, which is then fine-tuned with the missing data. The generated data is tested by a discriminator to determine if it can replace the original data.",
    "solution_structure": "Federated learning module, federated filling module, generation confrontation module, and completion testing module. The system also includes a node device with a communication circuit, memory, and processor.",
    "solution_implementation": "The federated learning module performs longitudinal learning on local sample data and the specified model. The federated filling module uses the obtained federated target model to generate an initial generator for missing completion. The generation confrontation module trains the target discriminator and generator based on the initial generator and sample data. The completion testing module completes missing test data using the generated model and tests its quality using the discriminator.",
    "effect": "Improved accuracy of missing data completion in federated learning systems"
  },
