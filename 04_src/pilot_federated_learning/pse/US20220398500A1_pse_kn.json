{
  "publication_number": "US20220398500A1",
  "title": "Partially local federated learning",
  "assignee": "Google LLC",
  "filing_date": "2021-05-27",
  "publication_date": "2022-12-15",
  "pse": {
    "problem": "Inefficient training of machine learning models, particularly deep models, due to data distribution over multiple clients and privacy concerns.",
    "solution_function": "Collaborative training of a machine learning model by exchanging local parameters between client devices and a server. Clients determine their local parameter updates based on local data and global parameters received from the server, then send updated parameters back to the server.",
    "solution_structure": "Client devices maintain local data and local parameters, while the server maintains global parameters. The system uses a dataset split function to partition local data into support and query datasets for training.",
    "solution_implementation": "Clients initialize local parameters, then iteratively perform gradient descent on those parameters using their local support dataset. Clients send parameter update data to the server after each iteration.",
    "effect": "Improved model accuracy through collective learning while preserving user privacy by minimizing data sharing"
  },
