{
  "publication_number": "CN111738440A",
  "title": "A model training method and system based on domain adaptation and federated learning",
  "assignee": "Alipay Hangzhou Information Technology Co Ltd",
  "filing_date": "2020-07-31",
  "publication_date": "2020-10-02",
  "pse": {
    "problem": "The problem is the inability to accurately identify business object types in the target business domain while considering data privacy requirements of various business parties.",
    "solution_function": "The method performs iterative model training using domain adaptation and federated learning. The source service side device processes labeled samples from the source business domain, calculates local training gradients, and sends them to a training coordinator device. Simultaneously, the target service side device processes unlabeled samples from the target business domain and sends feature sets to the training coordinator. The training coordinator calculates a comprehensive training gradient for model updates based on local gradients and feature sets.",
    "solution_structure": "The system consists of source service side devices, target service side devices, and a training coordinator device.",
    "solution_implementation": "The process begins with initializing neural network models on both the source and target service side devices. Each iteration involves local processing of samples by source and target devices to generate feature sets, calculation of local gradients by the source device, and transmission of these data to the training coordinator. The coordinator then calculates a comprehensive training gradient for model updates.",
    "effect": "The solution provides accurate identification of business object types in the target business domain while maintaining privacy requirements."
  },
