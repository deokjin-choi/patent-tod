{
  "publication_number": "CN118734167A",
  "title": "A CNC tool health status assessment system and method based on federated learning under edge-cloud collaborative architecture",
  "assignee": "Tongji University",
  "filing_date": "2024-06-27",
  "publication_date": "2024-10-01",
  "pse": {
    "problem": "Data isolation and privacy leakage in CNC tool health status assessment using centralized deep learning methods",
    "solution_function": "A federated learning-based system that assesses CNC tool health status across multiple edge devices in an edge-cloud collaborative architecture, reducing data transmission and improving accuracy without compromising privacy.",
    "solution_structure": "Edge devices collect local data on CNC tool health status, a gateway aggregates and processes the data, and a cloud server coordinates the federated learning process and provides high-level predictions.",
    "solution_implementation": "Edge devices perform local feature extraction and model training using the federated averaging algorithm. The gateway combines the local models to generate an aggregate model, which is further refined by the cloud server through a centralized optimization process.",
    "effect": "Improved accuracy in CNC tool health status assessment with reduced data transmission, minimal privacy leakage, and distributed computation that scales better with increasing numbers of edge devices."
  },
