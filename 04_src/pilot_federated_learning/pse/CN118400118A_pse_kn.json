{
  "publication_number": "CN118400118A",
  "title": "A network intrusion detection method, device and system based on federated learning",
  "assignee": "Beijing University of Posts and Telecommunications",
  "filing_date": "2024-01-31",
  "publication_date": "2024-07-26",
  "pse": {
    "problem": "Existing network intrusion detection methods have data privacy issues, high computing resource requirements, and limited model generalization ability",
    "solution_function": "The method performs decentralized network intrusion detection using federated learning to improve accuracy and robustness while protecting user data privacy",
    "solution_structure": "Key components include participating devices (edge devices) for data collection, a central server for model aggregation, and a federated learning algorithm for cooperative training",
    "solution_implementation": "Participating devices collect and preprocess network traffic data locally, then send model updates to the central server. The central server aggregates these updates to update the global model. This process is repeated iteratively until convergence or a predefined number of iterations",
    "effect": "Improved data privacy through local processing and reduced need for user data storage, improved generalization ability through cooperative learning across multiple devices, and potential reduction in computing resource requirements due to distributed training"
  },
