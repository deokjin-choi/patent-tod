{
  "publication_number": "CN112328698A",
  "title": "Longitudinal federal learning incentive training method, electronic device and storage medium",
  "assignee": "Hangzhou Qulian Technology Co Ltd",
  "filing_date": "2020-11-19",
  "publication_date": "2021-02-05",
  "pse": {
    "problem": "The problem is the poor training effect in federal learning due to simple arithmetic mean operation for calculating incentives.",
    "solution_function": "The solution involves determining a learning mode, acquiring total model parameters and semi-incentive parameters from member parties (initiator and participant), linking total model parameters with semi-excitation parameters, acquiring semi-excitation parameters from a blockchain, using them as input for an excitation model to generate excitation parameters for all member parties.",
    "solution_structure": "The key components include initiator, participant, blockchain, and an excitation model.",
    "solution_implementation": "Initiator determines the learning mode, member parties acquire total model parameters and calculate loss values and semi-excitation parameters based on data. Initiator (if it has data) calculates sub-models and overall model. Semi-excitation parameters are obtained from blockchain and used as input for excitation model.",
    "effect": "Improved federal learning training effect through effective incentivization of member parties"
  },
