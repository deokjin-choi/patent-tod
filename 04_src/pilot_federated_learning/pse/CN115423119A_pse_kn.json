{
  "publication_number": "CN115423119A",
  "title": "Distributed federal learning medical institution data sharing method based on trust",
  "assignee": "Nanjing Agricultural University",
  "filing_date": "2022-09-23",
  "publication_date": "2022-12-02",
  "pse": {
    "problem": "Decentralized sharing of medical data while ensuring privacy protection and robustness",
    "solution_function": "A trust-based decentralized federated learning method that enables safe sharing of medical data through the following steps: training model parameters on local datasets, encrypting gradient values using homomorphic encryption, averaging internal model parameters, calculating credibility, selecting representative institutions based on Dijkstra algorithm, and updating global model.",
    "solution_structure": "Medical institutions divided into groups, each group having a representative medical institution, and data sets at individual institutions.",
    "solution_implementation": "Training local models, homomorphic encryption of gradient values, calculation of average values, credibility assessment, Euclidean distance computation, selection of participating representative institutions, calculation of global model update.",
    "effect": "Improved privacy security and robustness in decentralized federated learning for medical data sharing"
  },
