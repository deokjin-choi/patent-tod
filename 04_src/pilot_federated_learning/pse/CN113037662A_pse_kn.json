{
  "publication_number": "CN113037662A",
  "title": "Mobile equipment radio frequency distribution identification method based on federal learning",
  "assignee": "University of Electronic Science and Technology of China",
  "filing_date": "2021-03-02",
  "publication_date": "2021-06-25",
  "pse": {
    "problem": "Inefficient user authentication in untrusted environments due to limitations of traditional methods and hardware resources in mobile devices",
    "solution_function": "Performs mobile equipment identification using a federal learning-based method that involves preprocessing time domain data, constructing a distributed computing model, and training the model with a dynamic sample selection algorithm",
    "solution_structure": "Includes Rayleigh fading channel for acquiring time domain data, federated learning-based distributed computing model built using mobile equipment, and a hierarchical division of time domain data",
    "solution_implementation": "Preprocessing of time domain data, construction of the distributed computing model based on federal learning using mobile equipment, dynamic sample selection algorithm for training the model",
    "effect": "Provides privacy protection for local sensitive data and identifies mobile equipment in a distributed and resource-efficient manner"
  },
