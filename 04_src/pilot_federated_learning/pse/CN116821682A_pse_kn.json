{
  "publication_number": "CN116821682A",
  "title": "A federated learning system and method for autonomous driving car networking",
  "assignee": "University of Shanghai for Science and Technology",
  "filing_date": "2023-06-30",
  "publication_date": "2023-09-29",
  "pse": {
    "problem": "Existing federal learning systems for autonomous vehicle networks face security and privacy threats such as model parameter theft, low security performance, and poor model performance.",
    "solution_function": "The invention creates a federated learning system that reduces the risk of updated model parameters being stolen by malicious attackers, improves the safety of federal learning, protects vehicle privacy information, and enhances the performance of autonomous vehicles.",
    "solution_structure": "The system comprises a local training unit, a privacy protection unit, an intermediate layer aggregation unit, and a global aggregation unit. The local training unit trains AI models using local data, while the privacy protection unit safeguards sensitive information during model updates sent to the central server.",
    "solution_implementation": "In this system, each vehicle processes its own data locally for model training. Encrypted model updates are then sent to the intermediate layer aggregation unit, where they are aggregated and forwarded to the global aggregation unit for final model updates. The privacy protection unit ensures secure communication and prevents unauthorized access during these processes.",
    "effect": "The proposed federated learning system enhances security, protects privacy, and improves the performance of autonomous vehicles in a network, reducing the risks associated with traditional federal learning systems."
  },
