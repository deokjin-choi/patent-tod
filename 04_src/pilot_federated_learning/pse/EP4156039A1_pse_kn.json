{
  "publication_number": "EP4156039A1",
  "title": "Method and apparatus for federated learning, and chip",
  "assignee": "Huawei Technologies Co Ltd",
  "filing_date": "2021-06-15",
  "publication_date": "2023-03-29",
  "pse": {
    "problem": "Limited by data privacy concerns, users cannot share personal data, forming 'data islands'. This hinders training large-scale machine learning models via federated learning due to long training times and high communication overheads.",
    "solution_function": "The method performs federated learning on a machine learning model whose parameter is distributed. It allows nodes to exchange prior and posterior distributions of the model parameter, enabling faster convergence and reduced communication overheads.",
    "solution_structure": "The system consists of first and second nodes that have local training data and can communicate with each other for federated learning.",
    "solution_implementation": "Each node receives a prior distribution from another node. It trains the model based on the prior distribution and its local data to obtain a posterior distribution. The nodes exchange their posterior distributions to update the federated model.",
    "effect": "The method reduces training time of federated learning and communication overheads by finding a better improvement direction for the machine learning model, allowing for more controlled federated learning processes."
  },
