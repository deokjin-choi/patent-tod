{
  "publication_number": "CN118607661A",
  "title": "Local sharpness optimization method and system for federated learning based on approximate global perturbation",
  "assignee": "Shanghai AI Innovation Center",
  "filing_date": "2024-05-28",
  "publication_date": "2024-09-06",
  "pse": {
    "problem": "The federated learning method faces challenges due to data heterogeneity, resulting in overfitting and a sharp, uneven loss surface during convergence, limiting its generalization ability.",
    "solution_function": "Optimizes local sharpness of federated learning by considering global perturbations. It updates the parameters of the local model based on a local loss calculated using an approximated global perturbation and a preset local learning rate.",
    "solution_structure": "Involves a central server, multiple user nodes, a global model, and a local model.",
    "solution_implementation": "The global model is used to calculate an approximated global perturbation. A local loss is calculated using the approximated global perturbation and the preset local model. The local model parameters are updated based on the local loss and a preset local learning rate.",
    "effect": "Improves the generalization ability of federated learning by optimizing the loss surface during convergence, reducing overfitting due to data heterogeneity."
  },
