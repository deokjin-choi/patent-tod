{
  "publication_number": "CN117114138A",
  "title": "A federated learning method and system that supports rapid data revocation",
  "assignee": "Guangzhou Fanghe Data Co ltd",
  "filing_date": "2023-09-04",
  "publication_date": "2023-11-24",
  "pse": {
    "problem": "Existing federated learning methods cannot quickly revoke data from a global model without significant computational overhead when dealing with requests for data erasure.",
    "solution_function": "The system performs rapid data revocation by dividing device participants into groups, collaboratively sharing local models, aggregating hierarchical global models, running multiple levels of the global model on query data, and aggregating prediction results to obtain a final prediction for the query data.",
    "solution_structure": "Key components include multiple device participants, groups, central server, local models, hierarchical global models, and an aggregation method.",
    "solution_implementation": "The process involves dividing participants, collaborative sharing of local models, centralized aggregation of hierarchical global models, running multiple levels of the global model on query data, and aggregating prediction results.",
    "effect": "Reduces computational overhead during data revocation compared to traditional federated learning methods."
  },
