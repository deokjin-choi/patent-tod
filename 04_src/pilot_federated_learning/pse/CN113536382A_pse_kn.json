{
  "publication_number": "CN113536382A",
  "title": "Blockchain-based medical data sharing privacy-preserving method using federated learning",
  "assignee": "Beijing Institute of Technology BIT",
  "filing_date": "2021-08-09",
  "publication_date": "2021-10-22",
  "pse": {
    "problem": "Risk of personal privacy information exposure during collection, storage, sharing, and analysis of medical data in a big data environment",
    "solution_function": "Combines blockchain, IPFS, and federal learning to implement a privacy-protection method for medical data. The blockchain ensures data safety through its distributed storage mechanism and transparency, differential privacy adds noise to the data, and federal learning aggregates updates from multiple participants while preserving user privacy.",
    "solution_structure": "Blockchain network with nodes, IPFS for hash encryption of mass data, Federal Learning system with central server and multiple participants",
    "solution_implementation": "Data is hashed by IPFS to generate a permanent IPFS address, which is then uploaded to the blockchain. The federal learning model is used to train the model using local data sets and update the model weights on the central server. Differential privacy techniques add noise to the data and energy cost concentrations in the blockchain.",
    "effect": "Enhanced medical data privacy protection, increased data reliability, and improved scalability of the blockchain"
  },
