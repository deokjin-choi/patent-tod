{
  "publication_number": "CN117808571A",
  "title": "Risk prediction method and device for bank card transaction, computing equipment and storage medium",
  "assignee": "China Mobile Communications Group Co Ltd",
  "filing_date": "2022-09-23",
  "publication_date": "2024-04-02",
  "pse": {
    "problem": "Bank card transactions lack accurate risk identification due to limited information and delayed risk assessment.",
    "solution_function": "The system predicts risks in bank card transactions by using a pre-trained model that analyzes the characteristics of the target website and bank card account from DPI bills, with sample data obtained through federated learning.",
    "solution_structure": "Components include a DPI processor for bill extraction, URL parser for identification, Luhn algorithm verifier, and risk prediction model.",
    "solution_implementation": "The process involves DPI bill analysis to identify the target website identifier and bank card account, URL parsing to determine if it contains a bank card number, Luhn algorithm verification of identified fields, and risk prediction based on the pre-trained model with sample data from operator side and bank side.",
    "effect": "Improved security for bank card transactions by predicting risks in real-time and using both transaction and account characteristics."
  },
