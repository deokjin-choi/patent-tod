{
  "publication_number": "CN117114743A",
  "title": "Financial product conversion rate improving method based on federal learning and blockchain",
  "assignee": "Hangzhou Beisaidi Technology Co ltd",
  "filing_date": "2023-02-23",
  "publication_date": "2023-11-24",
  "pse": {
    "problem": "Traditional identification methods ignore semantic information between tags and words as well as the gap between tag types.",
    "solution_function": "Improves financial product conversion rate by implementing a federated learning method with an incentive distribution mechanism. The method involves model training, evaluation, reward distribution, customer mining, and product recommendation.",
    "solution_structure": "The system consists of financial companies participating in federated learning, a regulatory agency coordinating the process, and a basic model provided by one financial company for improvement.",
    "solution_implementation": "The system functions as follows: 1. A financial company issues a model training request; 2. The request is broadcast to other financial companies; 3. Companies respond to the request (optional); 4. Federated model training occurs with data preprocessing, customer ID alignment, and model training; 5. Model evaluation takes place; 6. Reward distribution based on model performance; 7. Potential customer mining; 8. Recommendation of financial products.",
    "effect": "Improves financial product conversion rate by utilizing distributed data from various sources and offering incentives for participation."
  },
