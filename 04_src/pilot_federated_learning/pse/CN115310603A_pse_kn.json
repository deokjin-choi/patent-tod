{
  "publication_number": "CN115310603A",
  "title": "An assembly monitoring model training method and system based on federated transfer learning",
  "assignee": "South China University of Technology SCUT",
  "filing_date": "2022-06-30",
  "publication_date": "2022-11-08",
  "pse": {
    "problem": "The existing methods for robot assembly monitoring based on deep learning have high computational and data demands, struggle with diverse tasks, and do not consider task variability.",
    "solution_function": "The system performs federated transfer learning to build a model library, selectively fuses existing models, and updates the model library using the current task's trained model. This improves the utilization rate and transferability of the model in various task scenarios, reduces the dependence on sample data, and lessens the calculation amount during training.",
    "solution_structure": "A unified neural network structure model is defined as the robot assembly monitoring model, with multiple monitoring models of the same structure forming a federated learning model library for different subtask scenes.",
    "solution_implementation": "The system calculates task similarity based on client node characteristic data and selectively fuses existing models to provide initialization models for the current task. It then trains a model for the current task, updates the model library, and integrates fault detection models of different edge platforms.",
    "effect": "Improved generalization ability and response speed of the fault detection model, increased data transmission efficiency, enhanced industrial data security, reduced network bandwidth pressure, and improved effectiveness of the detection."
  },
