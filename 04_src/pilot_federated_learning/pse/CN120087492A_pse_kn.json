{
  "publication_number": "CN120087492A",
  "title": "A Federated Learning Method Based on Client Selection and Model Pruning",
  "assignee": "Hangzhou Zhiyuan Research Institute Co ltd",
  "filing_date": "2024-11-01",
  "publication_date": "2025-06-03",
  "pse": {
    "problem": "Limited resources in IoT systems cause high communication overhead and inefficiency in federal learning.",
    "solution_function": "The system selects a subset of clients for model training, prunes models using Top-K sparsity, aggregates updated local models at the server, and performs weighted average aggregation on the global model.",
    "solution_structure": "The system comprises N clients, a server, and parameters such as total communication round T, current communication round T, total local iteration round E, current local iteration round E, sets M t ,S t ,K t , a global model w t and others initialized by the system.",
    "solution_implementation": "In each iteration, the server randomly selects clients for model training; each client performs local model updating with Top-K sparsity, sends updated local model parameters to the server. In each communication round, the server calculates indexes and selects clients based on local model parameters sent by clients, aggregates global model using weighted average.",
    "effect": "Reduced extra communication overhead, improved convergence rate, and training efficiency while ensuring model training accuracy"
  },
