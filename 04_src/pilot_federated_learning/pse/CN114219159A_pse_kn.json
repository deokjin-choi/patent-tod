{
  "publication_number": "CN114219159A",
  "title": "A Production Line Scheduling Method Based on Federated Learning and Attention Mechanism",
  "assignee": "Hunan University",
  "filing_date": "2021-12-20",
  "publication_date": "2022-03-22",
  "pse": {
    "problem": "Existing production line scheduling methods have limitations in accuracy, efficiency, and cost due to inaccurate predictions and differences between theoretical and actual results.",
    "solution_function": "The system solves the scheduling problem of a job shop by adopting a federal learning and attention mechanism. It integrates the predicted production scheduling data from multiple part manufacturers, generates a global production part data model, and uses an attention mechanism to optimize the production line schedule.",
    "solution_structure": "The system consists of long-term and short-term memory networks for generating and training individual part manufacturer's production part data models. It also includes encryption, longitudinal federal learning, and an attention mechanism for collaborative training and optimization.",
    "solution_implementation": "The system initially establishes a production part data model using a long-term and short-term memory network. The model is trained with historical production part data, using gate control splicing training, selective memorization and forgetting, combination of selected inputs, optimization through a loss function, and normalization. Once the precision requirement is met, it generates a trained production part data model for prediction and conversion to original values.",
    "effect": "The system promises accurate and efficient production line scheduling, potentially reducing costs and improving efficiency."
  },
