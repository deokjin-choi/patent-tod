{
  "publication_number": "CN117033698A",
  "title": "Federal learning video recommendation method, system and device based on clustering",
  "assignee": "Guangdong University of Technology",
  "filing_date": "2023-08-04",
  "publication_date": "2023-11-10",
  "pse": {
    "problem": "Privacy leakage in video recommendation method due to data upload and server operations",
    "solution_function": "Clustering-based federated learning for secure video recommendation by calculating Hellinger distance matrix, performing hierarchical clustering, training models on local data, and aggregating models based on clusters",
    "solution_structure": "Client (generates tag vector, encrypts it), Server (calculates Hellinger distance matrix, performs hierarchical clustering, initializes cluster model, aggregates local models)",
    "solution_implementation": "Client generates a label vector, adjusts data processing with a specific formula, multiplies the orthogonal matrix by the data-processed label vector to obtain an encrypted label vector; Server calculates Hellinger distance based on encrypted tag vectors, performs hierarchical clustering, initializes cluster models for clusters, aggregates local models based on clusters, and loops until convergence",
    "effect": "Reduction of privacy leakage risk in video recommendation process"
  },
