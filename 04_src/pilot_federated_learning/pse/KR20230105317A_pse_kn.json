{
  "publication_number": "KR20230105317A",
  "title": "Method and apparatus for communication efficient federated learning with global model compression",
  "assignee": "(no assignee found)",
  "filing_date": "2022-12-28",
  "publication_date": "2023-07-11",
  "pse": {
    "problem": "The patent aims to solve the communication inefficiency issues in federated learning, particularly when dealing with large numbers of devices (e.g., millions of smartphones) that have limited bandwidth and battery power compared to traditional distributed learning in data centers.",
    "solution_function": "The solution provides a framework for communication-efficient federated learning, reducing downlink communication cost by compressing the global model, restoring feature maps to the server from local updates, performing quantization bias correction, and recognizing quantization.",
    "solution_structure": "The system includes multiple clients (devices), a server, and potentially parameter servers. The clients have local datasets, and the server aggregates local updates to update the global model.",
    "solution_implementation": "The method involves downloading the global model from the server by a subset of clients, locally updating it using their dataset, uploading local updates back to the server, aggregating received local updates at the server to update the global model, compressing (e.g., quantizing) the global model for downlink communication cost reduction, and reconstructing feature maps in the server for quantization bias correction.",
    "effect": "The benefits include reduced downlink communication cost, restoration of feature maps, quantization bias correction, and reduced compression loss, thereby improving the efficiency of federated learning in wireless settings."
  },
