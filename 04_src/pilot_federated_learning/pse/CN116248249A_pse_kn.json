{
  "publication_number": "CN116248249A",
  "title": "A gap-based group confusion attack method in federated learning",
  "assignee": "Southeast University",
  "filing_date": "2023-04-23",
  "publication_date": "2023-06-09",
  "pse": {
    "problem": "The gap-based group confusion attack method aims to exploit limitations in Byzantine federated learning defense systems by manipulating local data or parameters without assuming full knowledge of benign clients and servers (black-box attack).",
    "solution_function": "The GGO attacker measures the gap between two iterations element by element, locates important elements based on the size of the gap, and uses a specific attack function to collaboratively attack these important elements for optimization and cost reduction.",
    "solution_structure": "Key components include: local clients, global models, local datasets, central servers, and an attack function.",
    "solution_implementation": "The GGO attacker measures the gap between two iterations element by element, judges the importance of different elements based on the size of the gap, and uses a specific attack function to collude with other attackers and manipulate important elements in the model updates.",
    "effect": "By manipulating important elements in the model updates, the GGO attacker can optimize the attack performance and reduce attack consumption cost."
  },
