  "title": "Federated Learning Process",
  "assignee": "Telefonaktiebolaget LM Ericsson AB",
  "filing_date": "2022-12-23",
  "publication_date": "2025-05-08",
  "pse": {
    "problem": "Leakage of client's private data in Federated Learning processes due to server analyzing encrypted updates",
    "solution_function": "Anonymized data forwarding between clients to prevent the server from learning individual model updates and originators",
    "solution_structure": "Clients (originators and forwardees), a federated learning server",
    "solution_implementation": "Originator encrypts its local model update, forwards it to a forwardee who either submits or forwards the update to another forwardee. This multi-hop process continues until the update reaches the server.",
    "effect": "Prevents leakage of individual client's private data while maintaining privacy and anonymity in federated learning processes"
  },
