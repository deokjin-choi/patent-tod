{
  "publication_number": "KR20250023162A",
  "title": "Electronic device performing federated learning based on plurality of client terminals and method for operating the same",
  "assignee": "(no assignee found)",
  "filing_date": "2023-08-09",
  "publication_date": "2025-02-18",
  "pse": {
    "problem": "The rapid increase in smartphones and IoT devices generates large amounts of distributed data, leading to challenges in federated learning due to system heterogeneity and class imbalance.",
    "solution_function": "Selects a client terminal with the most local data, determines learning data distribution and amount based on it, selects another client terminal with data for the least-represented class, checks if the learning data distribution is uniform, and updates the learning data amount accordingly before transmission to the selected client terminals.",
    "solution_structure": "Plurality of client terminals, server.",
    "solution_implementation": "The electronic device collects class-specific data amount information from each client terminal, selects a first and second client terminal based on this information, determines learning data distribution and amount, checks the uniformity of updated learning data distribution, and transmits updated learning data amount to the selected client terminals.",
    "effect": "Improves learning efficiency by addressing class imbalance and system heterogeneity in federated learning"
  },
