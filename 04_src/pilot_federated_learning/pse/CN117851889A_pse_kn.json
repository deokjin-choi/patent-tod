{
  "publication_number": "CN117851889A",
  "title": "Power Internet of things abnormal operation data detection method based on federal learning",
  "assignee": "Electric Power Research Institute of State Grid Chongqing Electric Power Co Ltd",
  "filing_date": "2024-01-10",
  "publication_date": "2024-04-09",
  "pse": {
    "problem": "Insufficient accuracy in detecting abnormal data under massive data of a power Internet of Things",
    "solution_function": "The method constructs a federated learning-based anomaly detection model that efficiently identifies and analyzes complex data in the power Internet of Things",
    "solution_structure": "The system includes convolutional neural networks (CNN), support vector machines (SVM), autoencoders (AE), and Long Short Term Memory networks (LSTM) for data extraction, state classification, anomaly detection, and network state analysis respectively",
    "solution_implementation": "The model is trained and learned continuously to build a complete data state type library. During operation, the input data's information features are compared with the data sample library for efficient identification and analysis.",
    "effect": "Improved accuracy in detecting abnormal data, supporting stable and reliable operation of smart five-link systems in power Internet of Things"
  },
