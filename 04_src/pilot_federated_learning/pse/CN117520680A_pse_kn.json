{
  "publication_number": "CN117520680A",
  "title": "A personalized edge caching method empowered by federated forgetting",
  "assignee": "Dalian University of Technology",
  "filing_date": "2023-10-23",
  "publication_date": "2024-02-06",
  "pse": {
    "problem": "Inefficiency in personalized caching due to poor convergence on highly heterogeneous data and limited handling of invalid data in federal learning.",
    "solution_function": "A federally forgotten-enabled personalized edge caching method improves caching performance by designing a personalized federal learning scheme that reserves potential characteristics of different users, and a federal forgetting algorithm that eliminates the influence of invalid data on the federal learning model.",
    "solution_structure": "The solution involves distributed edge nodes, local devices (clients), a central server, and a federated learning model.",
    "solution_implementation": "Each client uploads only federal learning model parameters to the central server. The personalized federal learning scheme is used to train a more efficient machine learning model that makes use of the computing power of each data source while protecting their data security. The federal forgetting algorithm eliminates the influence of invalid data on the federated learning model.",
    "effect": "The solution results in great improvement of caching performance, reduction of service delay, and enhancement of accuracy."
  },
