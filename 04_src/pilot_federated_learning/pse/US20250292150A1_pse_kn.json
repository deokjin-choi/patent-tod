{
  "publication_number": "US20250292150A1",
  "title": "Systems and methods for balanced client selection for decentralized machine learning with non-iid data",
  "assignee": "Toyota Motor Corp",
  "filing_date": "2024-03-15",
  "publication_date": "2025-09-18",
  "pse": {
    "problem": "High communication overhead, significant infrastructure resources needed, and high infrastructure costs in centralized machine learning for vehicles",
    "solution_function": "Real-time client selection for decentralized machine learning using local data from vehicles for training machine learning models and aggregating them in a distributed manner",
    "solution_structure": "A vehicle with a processor device that trains local machine learning models and a controller device that performs balanced client selection in real-time for communication with connected vehicles",
    "solution_implementation": "Training of a first local machine learning model at a first mobile client using decentralized machine learning process, calculating class-wide data contribution estimation, aggregating the first and second machine learning models in the same process, and calculating class-wide data contribution for the aggregation",
    "effect": "Reduced communication overhead, infrastructure resources, and infrastructure costs by moving away from centralized systems towards distributed frameworks"
  },
