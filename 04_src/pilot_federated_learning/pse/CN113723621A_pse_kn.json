{
  "publication_number": "CN113723621A",
  "title": "Longitudinal federated learning modeling method, device, equipment and computer medium",
  "assignee": "JD Digital Technology Holdings Co Ltd",
  "filing_date": "2021-04-19",
  "publication_date": "2021-11-30",
  "pse": {
    "problem": "Inefficiency in longitudinal federated learning modeling due to consumption of large computing resources and time during data encryption and transmission.",
    "solution_function": "Improves efficiency of longitudinal federated learning by reducing data encrypted and transmitted through selective label decomposition, sub-label sequencing, and target sub-tag determination.",
    "solution_structure": "Includes a business side that stores labels, multiple data parties corresponding to each label for local data processing during federal learning, and optional components for label decomposition and sub-label sequencing.",
    "solution_implementation": "Label is decomposed into sub-labels, sorted by descending normalized amplitude values, and a target sub-tag is determined based on an energy loss calculation method that involves calculating a first loss value using MSE loss calculation. Each data party performs federal learning modeling with the distributed target sub-label and their local data.",
    "effect": "Reduction in computational resources and time consumed during data encryption and transmission, leading to increased efficiency of longitudinal federated learning"
  },
