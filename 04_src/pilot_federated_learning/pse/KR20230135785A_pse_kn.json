{
  "publication_number": "KR20230135785A",
  "title": "Federated Learning System Based on Intelligent Resource Sharing Scheme",
  "assignee": "(no assignee found)",
  "filing_date": "2022-03-17",
  "publication_date": "2023-09-26",
  "pse": {
    "problem": "Inefficiency in implementing machine learning algorithms for mobile service applications due to privacy protection restrictions for user data",
    "solution_function": "Federated Learning system performs global model learning by collecting and updating learning models from local devices without transmitting large-scale user data to a centralized edge/cloud server, addressing data privacy issues",
    "solution_structure": "Next-Generation Mobile Network (NGMN), 5G and 6G mobile communications adopt NR technology for wireless access between terminals and base stations. The system uses mobile edge computing (MEC) to migrate important cloud infrastructure, services, and platforms from Mobile Cloud Computing (MCC). Machine learning algorithms are implemented in a decentralized manner using network function virtualization (NFV), software defined networking (SDN), and self-organizing networking (SON)",
    "solution_implementation": "Local machine learning models are collected from terminals, and these models are used to learn and update the global model at the edge/cloud server. The system uses SDN for control flow and computation roles to manage data flows and optimize network resources",
    "effect": "Enables efficient implementation of machine learning algorithms in mobile service applications while addressing data privacy issues"
  },
