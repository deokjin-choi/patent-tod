{
  "publication_number": "CN116933888A",
  "title": "Method, apparatus and storage medium for evaluating contribution degree",
  "assignee": "Fujitsu Ltd",
  "filing_date": "2022-03-29",
  "publication_date": "2023-10-24",
  "pse": {
    "problem": "Distributed data islands make it difficult to share data among organizations for joint modeling in federated learning while preserving privacy and security.",
    "solution_function": "Evaluates the contribution of each participant in a federated learning network using the Shapley Value method, which calculates the marginal contribution of each participant to the overall organization by considering all possible permutations of participants.",
    "solution_structure": "Involves a blockchain network, servers for storing initial models, and multiple participating devices for local data training.",
    "solution_implementation": "Participants download initial models from servers, train models with local data, and upload updated models to the server. The server aggregates models, updates parameters, and sends the updated model to each participant. Participants retrain the received updated model with their local data until a satisfactory performance model is obtained.",
    "effect": "Provides an incentive mechanism for participants by fairly evaluating their contributions, encouraging participation and sharing of models in joint modeling"
  },
