{
  "publication_number": "US20230153633A1",
  "title": "Moderator for federated learning",
  "assignee": "Telefonaktiebolaget LM Ericsson AB",
  "filing_date": "2019-10-07",
  "publication_date": "2023-05-18",
  "pse": {
    "problem": "Inefficiency in federated learning systems due to non-uniform updates of local models, leading to potential bias and degraded performance for some nodes.",
    "solution_function": "Moderation of updates to the central model to prevent skewing or overfitting based on data from specific nodes, ensuring balanced performance across all distributed nodes.",
    "solution_structure": "Central model at the central node and local models at each distributed node. A moderator system for checking and adjusting updates to the central model.",
    "solution_implementation": "Moderator system checks individual updates from distributed nodes for drastic changes that may lead to bias. It prevents application of updates causing significant reductions in accuracy or enforces a limit on cumulative small changes favoring specific models.",
    "effect": "Improved performance and balance across all distributed nodes by preventing overfitting and bias in the central model."
  },
